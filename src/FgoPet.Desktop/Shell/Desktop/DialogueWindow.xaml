<Window x:Class="FgoPet.App.Dialogue.DialogueWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="/FgoPet.DesktopShell;component/Assets/AppIcon.ico"
 Title="FGO Pet · Chat" Width="440" Height="182" MinWidth="328" MinHeight="182" WindowStyle="None" WindowStartupLocation="Manual" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Background="#FBFAF8" UseLayoutRounding="True">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="6" /></WindowChrome.WindowChrome>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Border x:Name="ChatDragHandle" Height="22" Margin="6,0,6,0" Background="Transparent" Cursor="SizeAll"
          ToolTip="Drag to move · 拖动移动" AutomationProperties.Name="Drag to move · 拖动移动"
          MouseLeftButtonDown="OnDragHandleMouseDown">
   <Border Width="28" Height="3" CornerRadius="1.5" Background="#CFCBC3" IsHitTestVisible="False" />
  </Border>
  <ContentControl x:Name="ChatSurface" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
 </Grid>
</Window>
