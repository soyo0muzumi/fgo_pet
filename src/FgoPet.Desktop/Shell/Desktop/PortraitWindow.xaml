<Window x:Class="FgoPet.App.Main.PortraitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FgoPet"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="WidthAndHeight">
    <Canvas x:Name="HostCanvas">
        <ContentControl x:Name="Portrait" />
        <ContentControl x:Name="PanelHost" Visibility="Collapsed" />
    </Canvas>
</Window>
