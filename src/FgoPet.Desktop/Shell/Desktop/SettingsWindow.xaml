<Window x:Class="FgoPet.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/FgoPet.DesktopShell;component/Assets/AppIcon.ico"
        Title="FGO Pet · Settings"
        Width="1000" Height="780" MinWidth="320" MinHeight="360" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellWindowBackgroundBrush}"
        Foreground="{DynamicResource ShellTextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
</Window>
