<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Stable UI-foundation keys follow the currently loaded theme facts. -->
    <SolidColorBrush x:Key="Surface.App" Color="{DynamicResource Semantic.AppColor}" />
    <SolidColorBrush x:Key="Surface.Content" Color="{DynamicResource Semantic.ContentColor}" />
    <SolidColorBrush x:Key="Surface.Subtle" Color="{DynamicResource Semantic.SubtleColor}" />
    <SolidColorBrush x:Key="Surface.Hover" Color="{DynamicResource Semantic.HoverColor}" />
    <SolidColorBrush x:Key="Surface.Pressed" Color="{DynamicResource Semantic.PressedColor}" />
    <SolidColorBrush x:Key="Text.Primary" Color="{DynamicResource Semantic.PrimaryTextColor}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{DynamicResource Semantic.SecondaryTextColor}" />
    <SolidColorBrush x:Key="Action.Primary" Color="{DynamicResource Semantic.PrimaryActionColor}" />
    <SolidColorBrush x:Key="Action.OnPrimary" Color="{DynamicResource Semantic.OnPrimaryActionColor}" />
    <SolidColorBrush x:Key="Accent.Relation" Color="{DynamicResource Semantic.RelationColor}" />
    <SolidColorBrush x:Key="State.Success" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="State.Pending" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="State.Danger" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="Border.Decorative" Color="{DynamicResource Semantic.BorderDecorativeColor}" />
    <SolidColorBrush x:Key="Border.Control" Color="{DynamicResource Semantic.BorderControlColor}" />
    <SolidColorBrush x:Key="Focus.Ring" Color="{DynamicResource Semantic.FocusColor}" />
    <FontFamily x:Key="Typography.Ui">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>
    <Thickness x:Key="Spacing.Page">24</Thickness>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Content">10</CornerRadius>
    <CornerRadius x:Key="Radius.Floating">14</CornerRadius>
</ResourceDictionary>
