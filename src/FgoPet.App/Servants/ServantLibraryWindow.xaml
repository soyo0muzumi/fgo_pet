<Window x:Class="FgoPet.App.Servants.ServantLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从者库与设置"
        Width="920"
        Height="620"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox x:Name="ServantList"
                     ItemsSource="{Binding Servants}"
                     SelectedItem="{Binding SelectedServant}"
                     Margin="8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                            <TextBlock Text="{Binding PackageId}" Foreground="Gray" />
                            <TextBlock Text="{Binding SourceBadge}" Foreground="#C07030" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" Margin="8,0,8,8" Text="{Binding ScanStatus}"
                       Foreground="#606060" TextWrapping="Wrap" />
        </Grid>

        <StackPanel Grid.Column="1" Margin="12">
            <TextBlock Text="{Binding SelectedServant.DisplayName}" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding SelectedServant.SourceBadge}" Foreground="#C07030" />

            <ComboBox Margin="0,8,0,0"
                      ItemsSource="{Binding SelectedServant.Appearances}"
                      SelectedItem="{Binding CurrentAppearance}"
                      DisplayMemberPath="Display" />

            <Button Margin="0,8,0,0" Content="设为当前从者" Command="{Binding ActivateCommand}" />
            <Button Margin="0,8,0,0" Content="卸载第三方包" Command="{Binding UninstallCommand}" />
            <Button Margin="0,8,0,0" Content="打开角色包目录" Command="{Binding OpenPackFolderCommand}" />
            <Button Margin="0,8,0,0" Content="重新扫描" Command="{Binding RescanCommand}" />

            <TextBlock Margin="0,16,0,4" Text="安装本地 .fgopetpack" FontWeight="Bold" />
            <TextBox Text="{Binding PackFilePath, UpdateSourceTrigger=PropertyChanged}" />
            <Button Margin="0,8,0,0" Content="安装" Command="{Binding InstallCommand}" />

            <Border Margin="0,16,0,0"
                    Padding="8"
                    Background="#FFF3E0"
                    Visibility="{Binding IsDiagnosticVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding Diagnostic.Heading}" FontWeight="Bold" Foreground="#B05000" />
                    <TextBlock Text="{Binding Diagnostic.Text}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
