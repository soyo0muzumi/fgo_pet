<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="FgoPet.ThemeDictionary">FgoLight</sys:String>

    <Color x:Key="WindowBackgroundColor">#FFF0F3F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#FFF8FAFC</Color>
    <Color x:Key="SurfaceHoverColor">#FFEAF0F6</Color>
    <Color x:Key="SurfacePressedColor">#FFDCE5EF</Color>
    <Color x:Key="SidebarColor">#FF172A43</Color>
    <Color x:Key="SidebarForegroundColor">#FFD5E0ED</Color>
    <Color x:Key="SidebarSelectedColor">#FF365371</Color>
    <Color x:Key="SidebarSelectedTextColor">#FFFFF5D8</Color>
    <Color x:Key="SidebarHoverColor">#FF233D5D</Color>
    <Color x:Key="TextColor">#FF202C3A</Color>
    <Color x:Key="MutedTextColor">#FF5B6C7E</Color>
    <Color x:Key="SubtleTextColor">#FF8796A5</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>
    <Color x:Key="AccentColor">#FFAA823C</Color>
    <Color x:Key="AccentHoverColor">#FFC39B54</Color>
    <Color x:Key="AccentPressedColor">#FF8D682C</Color>
    <Color x:Key="AccentSoftColor">#2FAA823C</Color>
    <Color x:Key="BorderColor">#FFC7D2DE</Color>
    <Color x:Key="BorderStrongColor">#FF8EA1B4</Color>
    <Color x:Key="DividerColor">#33A0B1C2</Color>
    <Color x:Key="FocusColor">#FF3D6D96</Color>
    <Color x:Key="WarningColor">#FFAA7626</Color>
    <Color x:Key="WarningSoftColor">#33AA7626</Color>
    <Color x:Key="DangerColor">#FFB44C5D</Color>
    <Color x:Key="DangerHoverColor">#FFD06978</Color>
    <Color x:Key="DangerSoftColor">#33B44C5D</Color>
    <Color x:Key="SuccessColor">#FF2D805D</Color>
    <Color x:Key="SuccessSoftColor">#332D805D</Color>
    <Color x:Key="CardShadowColor">#263D536C</Color>
    <Color x:Key="InputBackgroundColor">#FFF7F9FB</Color>
    <Color x:Key="InputDisabledColor">#FFE8EDF2</Color>
    <Color x:Key="DisabledTextColor">#FF9AA7B4</Color>
    <Color x:Key="DisabledBorderColor">#FFD6DEE7</Color>
    <Color x:Key="OverlayColor">#660D1C2D</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarForegroundBrush" Color="{StaticResource SidebarForegroundColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarForegroundColor}" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource SidebarSelectedColor}" />
    <SolidColorBrush x:Key="SidebarSelectedTextBrush" Color="{StaticResource SidebarSelectedTextColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="{StaticResource SubtleTextColor}" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource SubtleTextColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="CardShadowBrush" Color="{StaticResource CardShadowColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="InputDisabledBrush" Color="{StaticResource InputDisabledColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="{StaticResource DisabledBorderColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
</ResourceDictionary>
