<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="FgoPet.ThemeDictionary">ModernGray</sys:String>

    <Color x:Key="WindowBackgroundColor">#FF1B212B</Color>
    <Color x:Key="SurfaceColor">#FF252C37</Color>
    <Color x:Key="SurfaceRaisedColor">#FF303946</Color>
    <Color x:Key="SurfaceHoverColor">#FF3A4452</Color>
    <Color x:Key="SurfacePressedColor">#FF465364</Color>
    <Color x:Key="SidebarColor">#FF171D25</Color>
    <Color x:Key="SidebarForegroundColor">#FFB5C0CE</Color>
    <Color x:Key="SidebarSelectedColor">#FF314052</Color>
    <Color x:Key="SidebarSelectedTextColor">#FFF2F6FB</Color>
    <Color x:Key="SidebarHoverColor">#FF222B36</Color>
    <Color x:Key="TextColor">#FFF2F5F8</Color>
    <Color x:Key="MutedTextColor">#FFB0BCC9</Color>
    <Color x:Key="SubtleTextColor">#FF7E8B9A</Color>
    <Color x:Key="TextOnAccentColor">#FF101820</Color>
    <Color x:Key="AccentColor">#FF6EB7E8</Color>
    <Color x:Key="AccentHoverColor">#FF89C8F0</Color>
    <Color x:Key="AccentPressedColor">#FF4E9FD5</Color>
    <Color x:Key="AccentSoftColor">#336EB7E8</Color>
    <Color x:Key="BorderColor">#FF414D5C</Color>
    <Color x:Key="BorderStrongColor">#FF657487</Color>
    <Color x:Key="DividerColor">#33414D5C</Color>
    <Color x:Key="FocusColor">#FF9AD5F4</Color>
    <Color x:Key="WarningColor">#FFE5B75B</Color>
    <Color x:Key="WarningSoftColor">#33E5B75B</Color>
    <Color x:Key="DangerColor">#FFE37383</Color>
    <Color x:Key="DangerHoverColor">#FFF28A98</Color>
    <Color x:Key="DangerSoftColor">#33E37383</Color>
    <Color x:Key="SuccessColor">#FF79C99C</Color>
    <Color x:Key="SuccessSoftColor">#3379C99C</Color>
    <Color x:Key="CardShadowColor">#66000000</Color>
    <Color x:Key="InputBackgroundColor">#FF202733</Color>
    <Color x:Key="InputDisabledColor">#FF2B323D</Color>
    <Color x:Key="DisabledTextColor">#FF6D7886</Color>
    <Color x:Key="DisabledBorderColor">#FF37414D</Color>
    <Color x:Key="OverlayColor">#990A0E14</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarForegroundBrush" Color="{StaticResource SidebarForegroundColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarForegroundColor}" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource SidebarSelectedColor}" />
    <SolidColorBrush x:Key="SidebarSelectedTextBrush" Color="{StaticResource SidebarSelectedTextColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="{StaticResource SubtleTextColor}" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource SubtleTextColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="CardShadowBrush" Color="{StaticResource CardShadowColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="InputDisabledBrush" Color="{StaticResource InputDisabledColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="{StaticResource DisabledBorderColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
</ResourceDictionary>
