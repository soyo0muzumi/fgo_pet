<Window x:Class="FgoPet.App.Memory.MemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="记忆与数据"
        Width="980"
        Height="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="候选记忆与已确认记忆" FontSize="18" FontWeight="Bold" />
                <CheckBox Content="启用记忆" IsChecked="{Binding MemoryEnabled, Mode=TwoWay}" Margin="18,4,0,0" />
                <TextBlock Text="当前从者：" Margin="18,4,0,0" Foreground="Gray" />
                <TextBlock Text="{Binding ActiveServantId}" Margin="0,4,0,0" Foreground="Gray" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="待审核候选" Margin="0,0,6,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="4">
                        <TextBox Text="{Binding CandidateEditText, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="42" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="编辑" Command="{Binding EditCandidateCommand}" Margin="0,0,6,0" />
                            <Button Content="确认" Command="{Binding ApproveCandidateCommand}" Margin="0,0,6,0" />
                            <Button Content="拒绝" Command="{Binding RejectCandidateCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="4" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="已确认记忆" Margin="6,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="4">
                        <TextBox Text="{Binding MemoryEditText, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="42" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="保存编辑" Command="{Binding EditMemoryCommand}" Margin="0,0,6,0" />
                            <Button Content="停用" Command="{Binding DisableMemoryCommand}" Margin="0,0,6,0" />
                            <Button Content="删除" Command="{Binding DeleteMemoryCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding StoredMemories}" SelectedItem="{Binding SelectedMemory}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding IsEnabled, StringFormat=启用：{0}}" Foreground="Gray" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="会话" Margin="6,0,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom"
                            Content="删除选中会话"
                            Command="{Binding DeleteConversationCommand}"
                            Margin="4" />
                    <ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding ConversationId}" />
                                    <TextBlock Text="{Binding UpdatedAtUtc}" Foreground="Gray" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="导出" Command="{Binding ExportCommand}" Margin="8,0,0,0" />
            <TextBox Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="DeleteAllButton" Content="删除全部用户数据" Click="OnDeleteAllClick" />
            <TextBlock Text="{Binding StatusText}" Margin="12,4,0,0" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
