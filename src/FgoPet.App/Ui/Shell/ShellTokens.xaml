<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="ShellWindowBackgroundBrush" Color="{DynamicResource Semantic.AppColor}" />
    <SolidColorBrush x:Key="ShellPanelBackgroundBrush" Color="{DynamicResource Semantic.SubtleColor}" />
    <SolidColorBrush x:Key="ShellRaisedBackgroundBrush" Color="{DynamicResource Semantic.ContentColor}" />
    <SolidColorBrush x:Key="ShellTextBrush" Color="{DynamicResource Semantic.PrimaryTextColor}" />
    <SolidColorBrush x:Key="ShellMutedTextBrush" Color="{DynamicResource Semantic.SecondaryTextColor}" />
    <SolidColorBrush x:Key="ShellBorderBrush" Color="{DynamicResource Semantic.BorderControlColor}" />
    <SolidColorBrush x:Key="ShellAccentBrush" Color="{DynamicResource Semantic.PrimaryActionColor}" />
    <SolidColorBrush x:Key="ShellAccentSoftBrush" Color="{DynamicResource Semantic.ActionSoftColor}" />
    <SolidColorBrush x:Key="ShellOverlayBrush" Color="{DynamicResource Semantic.OverlayColor}" />

    <sys:Double x:Key="ShellTitleHeight">42</sys:Double>
    <GridLength x:Key="ShellTitleGridLength">42</GridLength>
    <sys:Double x:Key="ShellNavWidth">190</sys:Double>
    <GridLength x:Key="ShellNavGridLength">190</GridLength>
    <sys:Double x:Key="ShellReadingWidth">680</sys:Double>
    <sys:Double x:Key="ShellTaskWidth">300</sys:Double>
    <sys:Double x:Key="ShellTaskOverlayMaxWidth">340</sys:Double>
    <sys:Double x:Key="ShellIconSize">34</sys:Double>

    <Thickness x:Key="ShellPagePadding">26</Thickness>
    <Thickness x:Key="ShellToolbarPadding">14,8</Thickness>
    <CornerRadius x:Key="ShellControlRadius">8</CornerRadius>
    <CornerRadius x:Key="ShellSurfaceRadius">12</CornerRadius>
    <CornerRadius x:Key="ShellComposerRadius">14</CornerRadius>
</ResourceDictionary>
