<UserControl x:Class="FgoPet.App.Settings.ThemePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Focusable="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsControls.xaml" />
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,4,14,18">
            <TextBlock Margin="0,0,0,14"
                       Style="{StaticResource SettingsStatusStyle}"
                       Text="选择后立即应用并保存。主题只影响设置窗口，运行时桌面宠物和对话面板继续使用既有深色终端配色。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="ModernGrayChoice"
                             Grid.Column="0"
                             MinHeight="190"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch"
                             Style="{StaticResource SettingsThemeChoiceStyle}"
                             IsChecked="{Binding IsModernGraySelected, Mode=OneWay}"
                             Checked="ThemeChoice_Checked"
                             ToolTip="选择 Modern Gray"
                             automation:AutomationProperties.Name="Modern Gray 主题"
                             automation:AutomationProperties.HelpText="中性灰色表面和克制的蓝色强调色">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#FF171D25"
                                CornerRadius="5"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#FF252C37"
                                        CornerRadius="3"
                                        Margin="0,0,8,0" />
                                <Border Grid.Column="1"
                                        Background="#FF6EB7E8"
                                        CornerRadius="3" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,4"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Modern Gray" />
                        <TextBlock Grid.Row="2"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="中性灰色表面、克制的 Windows 风格蓝色强调色，装饰密度更低。" />
                    </Grid>
                </RadioButton>

                <RadioButton x:Name="FgoLightChoice"
                             Grid.Column="1"
                             MinHeight="190"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch"
                             Style="{StaticResource SettingsThemeChoiceStyle}"
                             IsChecked="{Binding IsFgoLightSelected, Mode=OneWay}"
                             Checked="ThemeChoice_Checked"
                             ToolTip="选择 FGO Light"
                             automation:AutomationProperties.Name="FGO Light 主题"
                             automation:AutomationProperties.HelpText="深海军蓝导航、柔和金色强调色和克制的 FGO 风格细节">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#FF172A43"
                                CornerRadius="5"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#FFFFFFFF"
                                        CornerRadius="3"
                                        Margin="0,0,8,0" />
                                <Border Grid.Column="1"
                                        Background="#FFAA823C"
                                        CornerRadius="3" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,4"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="FGO Light" />
                        <TextBlock Grid.Row="2"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="海军蓝导航、柔和金色强调色和克制的 FGO 风格细节。" />
                    </Grid>
                </RadioButton>
            </Grid>

            <TextBlock x:Name="StatusTextBlock"
                       Margin="0,16,0,0"
                       Style="{StaticResource SettingsStatusStyle}"
                       Text="{Binding StatusText}"
                       automation:AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
