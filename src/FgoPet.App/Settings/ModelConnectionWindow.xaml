<Window x:Class="FgoPet.App.Settings.ModelConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型连接"
        Width="560"
        Height="520"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" Text="模型供应商" VerticalAlignment="Center" />
        <ComboBox x:Name="ProviderComboBox"
                  Grid.Row="0"
                  Grid.Column="1"
                  Margin="0,0,0,10"
                  ItemsSource="{Binding Providers}"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="ProviderId"
                  SelectedValue="{Binding SelectedProviderId, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" Text="API Key" VerticalAlignment="Center" />
        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="清除" Command="{Binding ClearKeyCommand}" />
            <PasswordBox x:Name="ApiKeyBox" ToolTip="密钥只保存到 Windows Credential Manager，不会写入设置文件。" />
        </DockPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,10" Text="Base URL" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,10" Text="当前 Model" VerticalAlignment="Center" />
        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="刷新" Command="{Binding RefreshModelsCommand}" />
            <TextBox x:Name="ModelTextBox" Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,10,10" Text="模型列表" VerticalAlignment="Top" />
        <ListBox Grid.Row="4" Grid.RowSpan="2" Grid.Column="1" Height="120" Margin="0,0,0,10" ItemsSource="{Binding AvailableModels}" DisplayMemberPath="DisplayName" />

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2">
            <TextBlock Text="{Binding StatusText}" Foreground="#555555" />
            <TextBlock Text="{Binding ErrorText}" Foreground="#B3261E" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0" Text="提示：没有模型连接时，桌宠与本地专注功能仍可离线运行。" Foreground="#777777" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Width="120" Margin="0,0,8,0" Content="跳过，离线使用" Click="OfflineButton_Click" />
                <Button Width="90" Margin="0,0,8,0" Content="测试连接" Command="{Binding TestCommand}" />
                <Button Width="90" Content="保存" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
