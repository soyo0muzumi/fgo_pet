<UserControl x:Class="FgoPet.App.Settings.RolePackagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsControls.xaml" />
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0,0,0,6">
        <Button x:Name="BackToAppearanceButton"
                Margin="0,0,0,12"
                HorizontalAlignment="Left"
                Style="{StaticResource SettingsSecondaryButtonStyle}"
                Content="← 外观与角色"
                Click="OnBackToAppearanceClick"
                automation:AutomationProperties.Name="返回外观与角色" />

        <Border Background="{DynamicResource Surface.Content}" BorderBrush="{DynamicResource Border.Decorative}"
                Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <TextBlock Text="查找已安装的角色包" Style="{StaticResource SettingsCaptionStyle}" />
                <TextBox x:Name="PackageSearchBox"
                         Style="{StaticResource SettingsTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         automation:AutomationProperties.Name="搜索角色包" />
            </StackPanel>
        </Border>

        <ItemsControl x:Name="PackageList" ItemsSource="{Binding FilteredServants}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Surface.Content}" BorderBrush="{DynamicResource Border.Decorative}"
                            Style="{StaticResource SettingsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="78" Height="92"
                                    Background="{DynamicResource Surface.Subtle}"
                                    BorderBrush="{DynamicResource Border.Decorative}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Grid>
                                    <Image Source="{Binding PreviewSource}" Stretch="UniformToFill" />
                                    <TextBlock Text="未提供预览" Foreground="{DynamicResource Text.Secondary}" FontSize="10"
                                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreviewSource}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PreviewSource}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}"
                                            Foreground="{DynamicResource Text.Primary}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Border Margin="8,0,0,0" Padding="6,2"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="3"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="当前" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,5,0,0" Text="{Binding PackageId}"
                                            Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}">
                                    <Run Text="版本 " /><Run Text="{Binding PackageVersion, Mode=OneWay}" />
                                            <Run Text="  ·  " /><Run Text="{Binding SourceBadge, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SettingsSecondaryButtonStyle}"
                                    Content="打开角色包"
                                    Click="OnOpenPackageClick"
                                    automation:AutomationProperties.Name="打开角色包" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Background="{DynamicResource Surface.Content}" BorderBrush="{DynamicResource Border.Decorative}"
                Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <TextBlock Text="安装本地角色包" Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,10" Text="选择 .fgopetpack 文件。安装完成后不会自动切换当前从者。"
                           Style="{StaticResource SettingsStatusStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PackageFilePathBox"
                             Style="{StaticResource SettingsTextBoxStyle}"
                             Text="{Binding PackFilePath, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="角色包文件路径" />
                    <Button Grid.Column="1" Margin="8,0,0,0"
                            Style="{StaticResource SettingsSecondaryButtonStyle}"
                            Content="选择文件"
                            Click="OnBrowsePackageClick" />
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource SettingsPrimaryButtonStyle}"
                            Content="安装"
                            Command="{Binding InstallCommand}" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource SettingsSecondaryButtonStyle}"
                            Content="重新扫描"
                            Command="{Binding RescanCommand}" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource SettingsSecondaryButtonStyle}"
                            Content="打开角色包目录"
                            Command="{Binding OpenPackFolderCommand}" />
                </WrapPanel>
                <TextBlock Margin="0,9,0,0" Text="{Binding ScanStatus}" Style="{StaticResource SettingsStatusStyle}" />
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource Surface.Subtle}" BorderBrush="{DynamicResource Border.Decorative}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="来源、兼容与隐私" Foreground="{DynamicResource Text.Primary}" FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                           Text="仅处理本机已选择的 .fgopetpack 文件；安装前会验证包声明、兼容版本和内容边界。来源未验证不代表官方或在线商店认证，角色包内容不会自动上传。" />
            </StackPanel>
        </Border>

        <Border Padding="12"
                Margin="0,0,0,12"
                Background="{DynamicResource WarningSoftBrush}"
                BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Visibility="{Binding IsDiagnosticVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding Diagnostic.Heading}" Foreground="{DynamicResource State.Pending}" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0" Text="{Binding Diagnostic.Text}" Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
