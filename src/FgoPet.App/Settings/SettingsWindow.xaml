<Window x:Class="FgoPet.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:FgoPet.App.Settings"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="设置"
        Width="980"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsControls.xaml" />
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Margin="18,20,18,16"
                           Foreground="{DynamicResource SidebarForegroundBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="FGO PET" />
                <ListBox x:Name="SettingsNavigation"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectedValuePath="Section"
                         SelectionChanged="SettingsNavigation_SelectionChanged"
                         automation:AutomationProperties.Name="设置导航">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}"
                               BasedOn="{StaticResource SettingsNavigationItemStyle}">
                            <Setter Property="ToolTip" Value="{Binding Label}" />
                            <Setter Property="automation:AutomationProperties.Name" Value="{Binding Label}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type settings:SettingsNavigationItem}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="17"
                                      Height="17"
                                      Margin="0,0,10,0"
                                      Stretch="Uniform"
                                      Stroke="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                                      StrokeThickness="1.35"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="{x:Type Path}">
                                            <Setter Property="Data" Value="{StaticResource IconProfileGeometry}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IconKey}" Value="IconPersonalizationGeometry">
                                                    <Setter Property="Data" Value="{StaticResource IconPersonalizationGeometry}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="IconRolePackageGeometry">
                                                    <Setter Property="Data" Value="{StaticResource IconRolePackageGeometry}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="IconConnectionGeometry">
                                                    <Setter Property="Data" Value="{StaticResource IconConnectionGeometry}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="IconAgentGeometry">
                                                    <Setter Property="Data" Value="{StaticResource IconConnectionGeometry}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="IconConversationGeometry">
                                                    <Setter Property="Data" Value="{StaticResource IconConversationGeometry}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="IconPrivacyGeometry">
                                                    <Setter Property="Data" Value="{StaticResource IconPrivacyGeometry}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IconKey}" Value="IconThemeGeometry">
                                                    <Setter Property="Data" Value="{StaticResource IconThemeGeometry}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="32,26,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel x:Name="PackageBreadcrumb"
                       Grid.Row="0"
                       Margin="0,0,0,14"
                       Visibility="Collapsed">
                <Button DockPanel.Dock="Left"
                        Margin="0,0,12,0"
                        Padding="8,4"
                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                        Command="{Binding BackToPackagesCommand}"
                        Content="返回角色包" />
                <TextBlock x:Name="PackageBreadcrumbText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </DockPanel>

            <StackPanel Grid.Row="1">
                <TextBlock x:Name="PageTitleText"
                           Style="{StaticResource SettingsPageHeaderStyle}" />
                <TextBlock x:Name="PageDescriptionText"
                           Style="{StaticResource SettingsPageDescriptionStyle}" />
            </StackPanel>

            <ScrollViewer Grid.Row="2"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="SettingsContent"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Top" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
