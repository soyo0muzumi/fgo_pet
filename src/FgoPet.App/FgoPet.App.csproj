<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Version>0.1.2</Version>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <RootNamespace>FgoPet.App</RootNamespace>
    <CompanionTargetFramework>net8.0-windows</CompanionTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FgoPet.Kernel\FgoPet.Kernel.csproj" />
    <ProjectReference Include="../../plugins/FgoPet.Plugin.Todo/Core/FgoPet.Plugin.Todo.Core.csproj" />

    <ProjectReference Include="../FgoPet.Platform/Windows/FgoPet.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\plugins\FgoPet.Plugin.Speech\Desktop\FgoPet.Speech.Desktop.csproj" />
    <ProjectReference Include="..\..\plugins\providers\FgoPet.Provider.Codex\FgoPet.AgentRelay\FgoPet.AgentRelay.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\providers\FgoPet.Provider.Codex\FgoPet.CodexAdapter\FgoPet.CodexAdapter.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="..\FgoPet.UiSdk\Resources\ThemeTokens.xaml">
      <Link>UiFoundation\ThemeTokens.xaml</Link>
    </Page>
    <Page Include="..\FgoPet.UiSdk\Resources\Controls.xaml">
      <Link>UiFoundation\Controls.xaml</Link>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FgoPet.App.Tests" />
    <InternalsVisibleTo Include="FgoPet.Windows.Tests" />
  </ItemGroup>
  <Target Name="CopySiblingRelay" AfterTargets="Build">
    <ItemGroup>
      <SiblingRelay Include="$(MSBuildProjectDirectory)\..\..\plugins\providers\FgoPet.Provider.Codex\FgoPet.AgentRelay\bin\$(Configuration)\$(CompanionTargetFramework)\$(RuntimeIdentifier)\FgoPet.AgentRelay.*" />
      <SiblingRelay Include="$(MSBuildProjectDirectory)\..\..\plugins\providers\FgoPet.Provider.Codex\FgoPet.CodexAdapter\bin\$(Configuration)\$(CompanionTargetFramework)\$(RuntimeIdentifier)\FgoPet.CodexAdapter.*" />
      <SiblingRelay Include="$(MSBuildProjectDirectory)\..\..\plugins\providers\FgoPet.Provider.Codex\FgoPet.CodexAdapter\bin\$(Configuration)\$(CompanionTargetFramework)\$(RuntimeIdentifier)\System.Security.Cryptography.ProtectedData.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SiblingRelay)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishSiblingRelay" AfterTargets="Publish">
    <ItemGroup>
      <PublishedCompanion Include="$(TargetDir)FgoPet.AgentRelay.*;$(TargetDir)FgoPet.CodexAdapter.*;$(TargetDir)System.Security.Cryptography.ProtectedData.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedCompanion)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <Page Include="..\FgoPet.UiSdk\Resources\Themes\FgoLight.xaml">
      <Link>Themes\FgoLight.xaml</Link>
    </Page>
    <Page Include="..\FgoPet.UiSdk\Resources\Themes\ModernGray.xaml">
      <Link>Themes\ModernGray.xaml</Link>
    </Page>
    <Page Include="..\FgoPet.UiSdk\Resources\Themes\SettingsIcons.xaml">
      <Link>Themes\SettingsIcons.xaml</Link>
    </Page>
    <Page Include="..\FgoPet.UiSdk\Resources\Shell\ShellControls.xaml">
      <Link>Ui\Shell\ShellControls.xaml</Link>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../plugins/FgoPet.Plugin.Content/Desktop/FgoPet.Character.csproj" />
    <ProjectReference Include="../FgoPet.Desktop/DataManagement/FgoPet.DataManagement.csproj" />
    <ProjectReference Include="../FgoPet.Desktop/Shell/FgoPet.DesktopShell.csproj" />
    <ProjectReference Include="../FgoPet.Desktop/Settings/FgoPet.SettingsHost.csproj" />
    <ProjectReference Include="../../plugins/FgoPet.Plugin.Dialogue/FgoPet.Dialogue.csproj" />
    <ProjectReference Include="../../plugins/FgoPet.Plugin.Focus/Desktop/FgoPet.Plugin.Focus.Desktop.csproj" />
    <ProjectReference Include="../FgoPet.Desktop/Contracts/FgoPet.HostContracts.csproj" />
    <ProjectReference Include="../../plugins/FgoPet.Plugin.Memory/Desktop/FgoPet.Memory.csproj" />
    <ProjectReference Include="../FgoPet.UiSdk/FgoPet.UiSdk.csproj" />
    <ProjectReference Include="../../plugins/providers/FgoPet.Provider.Codex/FgoPet.AgentBackend.Desktop/FgoPet.AgentBackend.Desktop.csproj" />
    <ProjectReference Include="../../plugins/FgoPet.Plugin.Todo/Desktop/FgoPet.Plugin.Todo.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../plugins/providers/FgoPet.Provider.IndexTts/FgoPet.Provider.IndexTts.csproj" />
    <ProjectReference Include="../../plugins/FgoPet.Plugin.Speech/Infrastructure/FgoPet.Speech.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../plugins/providers/FgoPet.Portrait.Static/FgoPet.Portrait.Static.csproj" />
    <ProjectReference Include="../../plugins/providers/FgoPet.Portrait.Live2D/FgoPet.Portrait.Live2D.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FgoPetLive2DRuntime)' != '' and Exists('$(FgoPetLive2DRuntime)')">
    <Content Include="$(FgoPetLive2DRuntime)\**\*">
      <Link>Live2D\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
