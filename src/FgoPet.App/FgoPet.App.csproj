      <Link>Themes\FgoLight.xaml</Link>
    </Page>
    <Page Include="..\..\ui-foundation\Themes\ModernGray.xaml">
      <Link>Themes\ModernGray.xaml</Link>
    </Page>
    <Page Include="..\..\ui-foundation\Themes\SettingsControls.xaml">
      <Link>Themes\SettingsControls.xaml</Link>
    </Page>
    <Page Include="..\..\ui-foundation\Themes\SettingsIcons.xaml">
      <Link>Themes\SettingsIcons.xaml</Link>
    </Page>

    <!-- ui-foundation/Shell -->
    <Page Include="..\..\ui-foundation\Shell\ChatControls.xaml">
      <Link>Ui\Shell\ChatControls.xaml</Link>
    </Page>
    <Page Include="..\..\ui-foundation\Shell\ShellControls.xaml">
      <Link>Ui\Shell\ShellControls.xaml</Link>
    </Page>
    <Page Include="..\..\ui-foundation\Shell\ShellTokens.xaml">
      <Link>Ui\Shell\ShellTokens.xaml</Link>
    </Page>

    <!-- modules/work -->
  </ItemGroup>
  <ItemGroup>
    <!-- 阶段 1 拆分新增 -->
    <ProjectReference Include="../../modules/character/src/FgoPet.Character/FgoPet.Character.csproj" />
    <ProjectReference Include="../../host/DataManagement/src/FgoPet.DataManagement/FgoPet.DataManagement.csproj" />
    <ProjectReference Include="../../host/DesktopShell/src/FgoPet.DesktopShell/FgoPet.DesktopShell.csproj" />
    <ProjectReference Include="../../modules/dialogue/src/FgoPet.Dialogue/FgoPet.Dialogue.csproj" />
    <ProjectReference Include="../../modules/focus/src/FgoPet.Focus/FgoPet.Focus.csproj" />
    <ProjectReference Include="../../host/DesktopShell/src/FgoPet.HostContracts/FgoPet.HostContracts.csproj" />
    <ProjectReference Include="../../modules/memory/src/FgoPet.Memory/FgoPet.Memory.csproj" />
    <ProjectReference Include="../../ui-foundation/src/FgoPet.UiFoundation/FgoPet.UiFoundation.csproj" />
    <ProjectReference Include="../../modules/work/Archives/src/FgoPet.Work.Archives/FgoPet.Work.Archives.csproj" />
    <ProjectReference Include="../../modules/work/Execution/src/FgoPet.Work.Execution/FgoPet.Work.Execution.csproj" />
    <ProjectReference Include="../../modules/work/Todo/src/FgoPet.Work.Todo/FgoPet.Work.Todo.csproj" />
  </ItemGroup>
</Project>
