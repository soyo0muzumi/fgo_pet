<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>0.1.2</Version>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <RootNamespace>FgoPet.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FgoPet.Core\FgoPet.Core.csproj" />
    <ProjectReference Include="..\FgoPet.Infrastructure\FgoPet.Infrastructure.csproj" />
    <ProjectReference Include="..\..\modules\speech\src\FgoPet.Speech.Desktop\FgoPet.Speech.Desktop.csproj" />
    <!-- 以下两条是运行时程序集拷贝，不是编译期引用（无 App 源码使用这两个程序集里的类型）：
         FgoPet.Infrastructure 会按输出目录启动它们的 exe ——
         Agents/CodexWorkerProcess.cs 解析 FgoPet.CodexAdapter.exe，文件缺失时抛 adapter_not_installed；
         Agents/CodexTargetCatalogClient.cs 同理（adapter list）。
         移除 ReferenceOutputAssembly="false" 会让 DI 侧拿到不该有的编译期耦合；
         删除整条 ProjectReference 会让 exe 不再落盘，Agent 派发在运行时炸。
         详见任务卡 B（结论：引用必需，保留）。 -->
    <ProjectReference Include="..\..\modules\agent-integration\src\FgoPet.AgentRelay\FgoPet.AgentRelay.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\modules\agent-integration\src\FgoPet.CodexAdapter\FgoPet.CodexAdapter.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Page Include="..\..\ui-foundation\ThemeTokens.xaml">
      <Link>UiFoundation\ThemeTokens.xaml</Link>
    </Page>
    <Page Include="..\..\ui-foundation\Controls.xaml">
      <Link>UiFoundation\Controls.xaml</Link>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FgoPet.App.Tests" />
    <InternalsVisibleTo Include="FgoPet.Windows.Tests" />
  </ItemGroup>
  <Target Name="CopySiblingRelay" AfterTargets="Build">
    <ItemGroup>
      <SiblingRelay Include="$(MSBuildProjectDirectory)\..\..\modules\agent-integration\src\FgoPet.AgentRelay\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\FgoPet.AgentRelay.*" />
      <SiblingRelay Include="$(MSBuildProjectDirectory)\..\..\modules\agent-integration\src\FgoPet.CodexAdapter\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\FgoPet.CodexAdapter.*" />
      <!-- WPF gets this assembly from WindowsDesktop; standalone companions need their own copy. -->
      <SiblingRelay Include="$(MSBuildProjectDirectory)\..\..\modules\agent-integration\src\FgoPet.CodexAdapter\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\System.Security.Cryptography.ProtectedData.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SiblingRelay)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishSiblingRelay" AfterTargets="Publish">
    <ItemGroup>
      <PublishedCompanion Include="$(TargetDir)FgoPet.AgentRelay.*;$(TargetDir)FgoPet.CodexAdapter.*;$(TargetDir)System.Security.Cryptography.ProtectedData.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedCompanion)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <!-- ===== ④ 迁移：跨目录源文件（搬目录后物理位置在根级模块树） ===== -->
  <!-- 物理位置已按 11→6 目标架构就位；程序集拆分留待后续，故此处用 Compile Include 回链。 -->
  <ItemGroup>
    <!-- host/DataManagement -->

    <!-- host/DesktopShell -->
    <Compile Include="..\..\host\DesktopShell\Application\App.xaml.cs">
      <Link>host\DesktopShell\Application\App.xaml.cs</Link>
    </Compile>
    <Compile Include="..\..\host\DesktopShell\Application\ServiceRegistration.cs">
      <Link>host\DesktopShell\Application\ServiceRegistration.cs</Link>
    </Compile>

    <!-- modules/character -->

    <!-- modules/dialogue -->

    <!-- modules/focus -->

    <!-- modules/memory -->

    <!-- modules/work -->

    <!-- ui-foundation/Theming -->
  </ItemGroup>
  <!-- ===== ④ 迁移：跨目录 XAML（物理位置在根级模块树；Link 保留原 App 相对路径以固定 pack URI） ===== -->
  <ItemGroup>
    <!-- host/DesktopShell -->
    <ApplicationDefinition Include="..\..\host\DesktopShell\Application\App.xaml">
      <Link>App.xaml</Link>
    </ApplicationDefinition>
  </ItemGroup>
  <ItemGroup>
    <!-- modules/dialogue -->

    <!-- host/DesktopShell -->

    <!-- modules/character -->

    <!-- modules/memory -->

    <!-- modules/dialogue -->

