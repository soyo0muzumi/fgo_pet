<UserControl x:Class="FgoPet.App.Views.TodoProposalCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="#3314243B" BorderBrush="#6642DFF5" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,7">
    <StackPanel>
      <TextBlock Text="TODO 提案 · 请确认" Foreground="#FF70E7F5" FontSize="9" FontWeight="Bold"/>
      <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Foreground="#FFF0F5FF" Background="#33101C2E" BorderBrush="#6638516C" BorderThickness="1" Padding="5" Margin="0,5,0,4"/>
      <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Foreground="#FFF0F5FF" Background="#33101C2E" BorderBrush="#6638516C" BorderThickness="1" Padding="5" MinHeight="32" TextWrapping="Wrap" AcceptsReturn="True"/>
      <Grid Margin="0,5,0,0">
        <TextBlock Text="{Binding ErrorText}" Foreground="#FFD242E8" FontSize="8" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="移除" Click="OnRemoveClick" Foreground="#FF9FB2D8" Background="Transparent" BorderThickness="0" Padding="5,3" FontSize="9"/>
          <Button Content="确认写入" Click="OnConfirmClick" Foreground="#FF70E7F5" Background="#2642DFF5" BorderBrush="#CC42DFF5" BorderThickness="1" Padding="7,3" FontSize="9" FontWeight="Bold"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
