<UserControl x:Class="FgoPet.App.Views.AgentCurrentTaskStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="#3314243B" BorderBrush="#6642DFF5" BorderThickness="1" Padding="7" Margin="0,0,0,8">
    <StackPanel>
      <Grid>
        <TextBlock Text="AGENT CURRENT / 当前任务" Foreground="#FF70E7F5" FontSize="9" FontWeight="Bold"/>
        <TextBlock Text="{Binding CurrentTaskId}" Foreground="#FF9FB2D8" FontSize="8" HorizontalAlignment="Right"/>
      </Grid>
      <TextBlock Text="{Binding CurrentTaskText}" Foreground="#FFF0F5FF" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <TextBlock Foreground="#FF9FB2D8" FontSize="8" Margin="0,2,0,0">
        <Run Text="另有 "/><Run Text="{Binding OtherActiveCount}"/><Run Text=" 项活跃任务"/>
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasOtherActiveTasks}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <Button Content="{Binding AttentionText}" Click="OnOpenTaskClick" Foreground="#FFD242E8" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="0,4" FontSize="9">
        <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding AttentionRequired}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
      <Button Content="人工核对结果" Click="OnReconcileClick" Foreground="#FFFFB84D" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="0,4" FontSize="9" AutomationProperties.Name="人工核对 Agent 执行结果">
        <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding OutcomeUnknown}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
      <Button Content="开始整理已完成工作" Click="OnArchiveClick" Foreground="#FFD242E8" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="0,4" FontSize="9">
        <Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding WantsToTalk}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
