<UserControl x:Class="FgoPet.App.Views.Settings.AgentConnectionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource SettingsCardStyle}">
      <StackPanel>
        <TextBlock Text="Agent 总开关" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
        <TextBlock Text="FGO Pet 只接收已授权来源的状态事件；关闭后不会删除配对或项目 allowlist。" Style="{StaticResource SettingsStatusStyle}" Margin="0,4,0,8" TextWrapping="Wrap"/>
        <CheckBox Content="启用 Agent 集成" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
        <Button Content="保存连接设置" Style="{StaticResource SettingsPrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnSaveClick"/>
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SettingsStatusStyle}" Margin="0,8,0,0"/>
        <Button Content="清除全部 Agent Todo 数据" Style="{StaticResource SettingsDangerButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnClearClick"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource SettingsCardStyle}">
      <StackPanel>
        <TextBlock Text="已配对来源" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
        <ItemsControl ItemsSource="{Binding Connections}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                <StackPanel>
                  <DockPanel><CheckBox IsChecked="{Binding IsEnabled}" Content="{Binding DisplayName}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Version}" Foreground="{DynamicResource MutedTextBrush}"/></DockPanel>
                  <TextBlock Text="{Binding SourceType}" Style="{StaticResource SettingsStatusStyle}"/>
                  <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="11"><Run Text="最后事件："/><Run Text="{Binding LastEventText}"/><Run Text=" · pending："/><Run Text="{Binding PendingCount}"/></TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
