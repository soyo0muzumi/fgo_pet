<UserControl x:Class="FgoPet.App.Views.ExpandedTodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <SolidColorBrush x:Key="Cyan" Color="#FF70E7F5"/>
    <SolidColorBrush x:Key="Mag" Color="#FFD242E8"/>
    <SolidColorBrush x:Key="Text" Color="#FFF0F5FF"/>
    <SolidColorBrush x:Key="Muted" Color="#FF9FB2D8"/>
    <Style x:Key="TodoTabButton" TargetType="Button">
      <Setter Property="Padding" Value="7,4"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Background" Value="#33101C2E"/>
      <Setter Property="BorderBrush" Value="#6638516C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </UserControl.Resources>
  <StackPanel x:Name="TimelineRoot">
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button Content="待办" Style="{StaticResource TodoTabButton}" Click="OnTodoTabClick"/>
        <Button Content="历史" Style="{StaticResource TodoTabButton}" Click="OnHistoryTabClick"/>
      </StackPanel>
      <CheckBox Grid.Column="1" Content="仅看今天" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center" IsChecked="{Binding OnlyToday, Mode=TwoWay}"/>
    </Grid>
    <TextBlock Text="TODO / 行动时间轴" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
    <ItemsControl ItemsSource="{Binding Groups}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,0,0,5">
            <TextBlock Text="{Binding Header}" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                      <Border Width="1" Background="#6642DFF5" HorizontalAlignment="Center" Margin="0,0,0,-7"/>
                      <Ellipse Width="7" Height="7" Fill="{Binding StatusAccent}" Stroke="{Binding StatusAccent}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                      <Grid>
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusAccent}" FontSize="9" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding DueText}" Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Right"/>
                      </Grid>
                      <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="11" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      <TextBlock Text="{Binding PriorityText}" Foreground="{StaticResource Muted}" FontSize="8" Margin="0,2,0,0"/>
                      <StackPanel Visibility="{Binding Execution.IsOutcomeUnknown, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Execution.DiagnosticBlock}" Foreground="{StaticResource Muted}" FontSize="8" TextWrapping="Wrap"/>
                        <Button Content="复制核对标识" Tag="{Binding Execution.DiagnosticBlock}" Click="OnCopyDiagnosticClick"
                                AutomationProperties.Name="复制待核对任务标识"
                                Foreground="{StaticResource Cyan}" Background="Transparent" BorderThickness="0"
                                Padding="0,3" HorizontalAlignment="Left" FontSize="8" Cursor="Hand"/>
                      </StackPanel>
                      <Button Content="交给 Agent" Tag="{Binding Item}" Click="OnDispatchClick"
                              IsEnabled="{Binding CanDispatch}"
                              AutomationProperties.Name="交给 Agent"
                              Foreground="{StaticResource Cyan}" Background="#26101C2E"
                              BorderBrush="#6638516C" BorderThickness="1"
                              Padding="7,3" Margin="0,5,0,0"
                              HorizontalAlignment="Right" FontSize="9" Cursor="Hand"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl ItemsSource="{Binding WorkArchives}" Margin="0,3,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="#3314243B" BorderBrush="#6642DFF5" BorderThickness="1" Padding="6" Margin="19,0,0,5">
            <StackPanel>
              <TextBlock Text="工作归档" Foreground="{StaticResource Cyan}" FontSize="8" FontWeight="Bold"/>
              <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Text}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="8"><Run Text="{Binding ArchiveDate}"/><Run Text=" · 覆盖 " /><Run Text="{Binding CoveredTodoKeys.Count}"/><Run Text=" 条 Todo"/></TextBlock>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="还有更多待办，可在此区域滚动查看" Foreground="{StaticResource Muted}" FontSize="8" Margin="19,0,0,0">
      <TextBlock.Style>
        <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasOverflow}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
      </TextBlock.Style>
    </TextBlock>
  </StackPanel>
</UserControl>
