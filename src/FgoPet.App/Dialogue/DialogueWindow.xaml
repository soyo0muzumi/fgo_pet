<Window x:Class="FgoPet.App.Dialogue.DialogueWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FGO Pet · 聊天" Width="720" Height="640" MinWidth="500" MinHeight="540" WindowStartupLocation="Manual" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Background="{DynamicResource ShellWindowBackgroundBrush}" Foreground="{DynamicResource ShellTextBrush}" UseLayoutRounding="True">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/FgoPet.App;component/Ui/Shell/ChatControls.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Bool"/></ResourceDictionary></Window.Resources>
<Grid x:Name="ShellRoot"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,0,1">
<Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Button x:Name="HistoryButton" Style="{StaticResource ChatButton}" Content="{StaticResource ChatHistory}" ContentTemplate="{StaticResource ChatIcon}" Click="OnHistoryClick" ToolTip="历史对话" AutomationProperties.Name="历史对话"/>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><Border Width="30" Height="30" Background="{DynamicResource ShellPanelBackgroundBrush}" CornerRadius="8"><Image Source="{Binding SelectedServant.PreviewSource}" Stretch="Uniform"/></Border><StackPanel Margin="9,0"><TextBlock Text="{Binding ActiveServantDisplayName}" FontWeight="SemiBold" MaxWidth="240" TextTrimming="CharacterEllipsis"/><TextBlock Text="在这里陪你整理一下" FontSize="12" Foreground="{DynamicResource ShellMutedTextBrush}"/></StackPanel></StackPanel>
<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="TasksButton" Style="{StaticResource ChatButton}" Content="{StaticResource ChatTasks}" ContentTemplate="{StaticResource ChatIcon}" ToolTip="接下来" AutomationProperties.Name="接下来" Click="OnTasksClick"/><Button Margin="8,0" Style="{StaticResource ChatButton}" Content="{StaticResource ChatNew}" ContentTemplate="{StaticResource ChatIcon}" ToolTip="新对话" AutomationProperties.Name="新对话" Click="OnNewClick"/><Button Style="{StaticResource ChatButton}" Content="{StaticResource ChatHide}" ContentTemplate="{StaticResource ChatIcon}" ToolTip="收起聊天，桌宠继续显示" AutomationProperties.Name="收起聊天" Click="OnHideClick"/></StackPanel>
</Grid></Border>
<Grid Grid.Row="1" x:Name="ChatBody" Margin="22,16,22,14"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid>
<ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel MaxWidth="608" Margin="0,8,0,16">
<StackPanel x:Name="Welcome" Margin="18,40,18,24" HorizontalAlignment="Center"><Border Width="86" Height="98" Background="{DynamicResource ShellPanelBackgroundBrush}" CornerRadius="16"><Image Source="{Binding SelectedServant.PreviewSource}" Stretch="Uniform"/></Border><TextBlock Text="{Binding ActiveServantDisplayName}" Foreground="{DynamicResource ShellAccentBrush}" HorizontalAlignment="Center" Margin="0,14,0,12"/><TextBlock Text="今天也按自己的节奏来。" FontSize="23" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="想说点什么就告诉我。需要整理事情的时候，我们再一起拆小一点。" Foreground="{DynamicResource ShellMutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="410" Margin="0,10,0,0"/></StackPanel>
<TextBlock Text="正在回复…" Margin="0,0,0,8" Foreground="{DynamicResource ShellAccentBrush}" Visibility="{Binding Conversation.IsStreaming, Converter={StaticResource Bool}}"/><ItemsControl ItemsSource="{Binding Conversation.Turns}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,22">
<Border Padding="14,10" CornerRadius="14"><Border.Style><Style TargetType="Border"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="{DynamicResource ShellPanelBackgroundBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsAssistant}" Value="True"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ShellTextBrush}" FontSize="14" Padding="0" Style="{StaticResource ChatInput}"/></Border>
<StackPanel Orientation="Horizontal" Margin="0,4,0,0">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="HorizontalAlignment" Value="Right"/><Style.Triggers><DataTrigger Binding="{Binding IsAssistant}" Value="True"><Setter Property="HorizontalAlignment" Value="Left"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
<Button IsEnabled="{Binding Actions.CanCopy}" Content="{StaticResource ChatCopy}" Tag="{Binding}" Click="OnCopyClick" Style="{StaticResource ChatMessageAction}" ToolTip="复制" AutomationProperties.Name="复制" Margin="0,0,4,0"/>
<Button Tag="{Binding}" Click="OnSpeechClick" ToolTip="{Binding SpeechActionText}" AutomationProperties.Name="{Binding SpeechActionText}" Visibility="{Binding CanReadAloud, Converter={StaticResource Bool}}">
<Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChatMessageAction}"><Setter Property="Content" Value="{StaticResource ChatSpeak}"/><Style.Triggers><DataTrigger Binding="{Binding SpeechActionText}" Value="停止朗读"><Setter Property="Content" Value="{StaticResource ChatStop}"/><Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
</Button></StackPanel>
</StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="{Binding Conversation.RequestStatusText}" Foreground="{DynamicResource ShellMutedTextBrush}" TextWrapping="Wrap" FontSize="12"/>
<Border x:Name="FailureNotice" BorderBrush="#B34F59" BorderThickness="3,0,0,0" Padding="12,8" Margin="0,8" Visibility="Collapsed"><StackPanel><TextBlock Text="{Binding Conversation.ErrorText}" Foreground="#B34F59" TextWrapping="Wrap"/><TextBlock Text="输入内容已保留，可以检查后重新发送。" FontSize="12" Foreground="{DynamicResource ShellMutedTextBrush}" Margin="0,6"/><Button Content="重新发送输入内容" Command="{Binding Conversation.SendCommand}" Style="{StaticResource ChatTextButton}" HorizontalAlignment="Left"/></StackPanel></Border><TextBlock x:Name="StoppedNotice" Text="已停止生成" FontSize="12" Foreground="{DynamicResource ShellMutedTextBrush}" Visibility="Collapsed" Margin="0,8"/>
<Button Content="配置聊天模型" Command="{Binding Conversation.OpenSettingsCommand}" Style="{StaticResource ChatTextButton}" HorizontalAlignment="Left" Visibility="{Binding Conversation.IsConfigurationStateVisible, Converter={StaticResource Bool}}"/>
</StackPanel></ScrollViewer>
<Button x:Name="JumpButton" Content="回到底部" Style="{StaticResource ChatTextButton}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Click="OnJumpClick" Visibility="Collapsed"/>
</Grid>
<Border Grid.Row="1" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource ShellBorderBrush}" Background="{DynamicResource ShellRaisedBackgroundBrush}" Padding="12,10" Margin="0,12,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><TextBox x:Name="InputBox" Style="{StaticResource ChatInput}" MinHeight="52" MaxHeight="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding Composer.InputText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="聊天输入"/><TextBlock IsHitTestVisible="False" Text="说些什么……" Margin="6" Foreground="{DynamicResource ShellMutedTextBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Composer.InputText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
<DockPanel Grid.Row="1" Margin="0,6,0,0"><Button x:Name="SendButton" DockPanel.Dock="Right" Command="{Binding Composer.SendOrStopCommand}" ContentTemplate="{StaticResource ChatIcon}" ToolTip="{Binding Composer.ActionLabel}" AutomationProperties.Name="{Binding Composer.ActionLabel}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChatButton}"><Setter Property="Content" Value="{StaticResource ChatSend}"/><Setter Property="Background" Value="{DynamicResource ShellAccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource ShellWindowBackgroundBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Conversation.IsStreaming}" Value="True"><Setter Property="Content" Value="{StaticResource ChatStop}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="Enter 发送 · Shift + Enter 换行" FontSize="12" Foreground="{DynamicResource ShellMutedTextBrush}" VerticalAlignment="Center"/></DockPanel>
</Grid></Border>
</Grid>
<Button x:Name="Backdrop" Grid.Row="1" Background="#552C2733" Visibility="Collapsed" Click="OnCloseClick" AutomationProperties.Name="返回聊天"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Button.Template></Button>
<Border x:Name="HistoryDrawer" Grid.Row="1" Width="276" HorizontalAlignment="Left" Background="{DynamicResource ShellPanelBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,1,0" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
<Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource ChatButton}" Content="{StaticResource ChatClose}" ContentTemplate="{StaticResource ChatIcon}" Click="OnCloseClick" ToolTip="返回聊天"/><TextBlock Text="历史对话" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><Button Grid.Row="1" Content="新对话" Style="{StaticResource ChatTextButton}" Margin="0,12" Click="OnNewClick"/><ListBox x:Name="HistoryList" Grid.Row="2" ItemsSource="{Binding Conversation.History}" ItemContainerStyle="{StaticResource ChatHistoryItem}" BorderThickness="0" Background="Transparent" SelectionChanged="OnHistorySelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UpdatedText}" FontSize="12" Foreground="{DynamicResource ShellMutedTextBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
</Border>
<Border x:Name="TasksDrawer" Grid.Row="1" Width="276" HorizontalAlignment="Right" Background="{DynamicResource ShellPanelBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
<Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource ChatButton}" Content="{StaticResource ChatClose}" ContentTemplate="{StaticResource ChatIcon}" Click="OnCloseClick" ToolTip="返回聊天"/><TextBlock Text="接下来" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,0,0"><TextBlock Text="已确认的待办" FontSize="12" Foreground="{DynamicResource ShellMutedTextBrush}"/><ItemsControl x:Name="TaskList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ShellBorderBrush}" Padding="0,14"><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource ShellMutedTextBrush}" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Grid>
</Border>
</Grid></Window>