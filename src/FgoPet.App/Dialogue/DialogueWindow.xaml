<Window x:Class="FgoPet.App.Dialogue.DialogueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:views="clr-namespace:FgoPet.App.Views"
        Title="对话"
        Width="760"
        Height="560"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style x:Key="DialogueExpanderStyle" TargetType="{x:Type Expander}">
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Expander}">
                            <StackPanel>
                                <ToggleButton x:Name="HeaderSite"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0"
                                              HorizontalContentAlignment="Left"
                                              Cursor="Hand"
                                              automation:AutomationProperties.Name="展开或折叠历史会话">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderChrome"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="7,5">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="Chevron"
                                              Width="8"
                                              Height="6"
                                              Margin="2,0,8,0"
                                              VerticalAlignment="Center"
                                              Fill="{DynamicResource AccentBrush}"
                                              Data="M 0,0 L 8,0 L 4,5 Z" />
                                        <ContentPresenter ContentSource="Header"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                    </StackPanel>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite"
                                                  ContentSource="Content"
                                                  Margin="0,3,0,0"
                                                  Visibility="Collapsed" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ContentSite" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="False">
                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="-90" CenterX="4" CenterY="2.5" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Margin="16,18,16,14"
                           Foreground="{DynamicResource SidebarForegroundBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="对话" />
                <Expander Grid.Row="1"
                          Margin="8,0,8,8"
                          IsExpanded="True"
                          Style="{StaticResource DialogueExpanderStyle}"
                          automation:AutomationProperties.Name="展开或折叠历史会话">
                    <Expander.Header>
                        <TextBlock Text="历史会话" FontSize="12" />
                    </Expander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListBox x:Name="HistoryList"
                                 Grid.Row="0"
                                 ItemsSource="{Binding Conversation.History}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="OnHistorySelectionChanged"
                                 automation:AutomationProperties.Name="历史会话列表">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="HistoryItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="HistoryItemBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="HistoryItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        <Setter TargetName="HistoryItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding UpdatedText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Margin="8,6,8,0">
                            <TextBlock Text="{Binding Conversation.HistoryStatus}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                            <Button Content="重试加载" Command="{Binding Conversation.RetryHistoryCommand}" Margin="0,6,0,0" Padding="6,3" HorizontalAlignment="Left">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsSecondaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Conversation.HistoryStatus}" Value="历史会话加载失败，请重试。">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Expander>
                <Button Grid.Row="2"
                        Content="＋ 新对话"
                        Command="{Binding Conversation.NewConversationCommand}"
                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                        Margin="16,0"
                        HorizontalAlignment="Stretch"
                        Padding="10,7"
                        automation:AutomationProperties.Name="新对话" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" MinHeight="28" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <ScrollViewer x:Name="MessageScroller"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  automation:AutomationProperties.Name="对话消息">
                        <StackPanel x:Name="MessageListHost" Margin="16,14,16,10">
                            <StackPanel x:Name="EmptyState"
                                        HorizontalAlignment="Center"
                                        Margin="0,40,0,10">
                                <TextBlock Text="等待你的第一句话"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="从者频道已就绪。输入一句话开始对话。"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,6,0,0"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border x:Name="ConfigurationCard"
                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1,0,0,0"
                                    CornerRadius="2"
                                    Margin="0,0,0,10"
                                    Padding="10,9"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="尚未配置模型连接"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontSize="12"
                                               FontWeight="Bold" />
                                    <TextBlock Text="对话需要 OpenAI 格式的模型供应商。角色包与本地功能仍可离线使用。"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,8" />
                                    <Button Content="去设置 · AI 模型与连接"
                                            Command="{Binding Conversation.OpenSettingsCommand}"
                                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Padding="10,5" />
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="MessageList"
                                          ItemsSource="{Binding Conversation.Turns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9"
                                              HorizontalAlignment="Stretch">
                                        <StackPanel
                                                    MaxWidth="680"
                                                    HorizontalAlignment="{Binding Alignment}">
                                            <!-- Reasoning well (spec §9): transient, window-only. -->
                                            <Border x:Name="ReasoningWell"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="9,6"
                                                    Margin="0,0,0,4"
                                                    automation:AutomationProperties.Name="思考过程"
                                                    >
                                                <StackPanel>
                                                    <ToggleButton x:Name="ReasoningToggle"
                                                                  HorizontalAlignment="Left"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  Padding="0"
                                                                  IsChecked="{Binding IsReasoningExpanded, Mode=TwoWay}"
                                                                  Cursor="Hand"
                                                                  automation:AutomationProperties.Name="展开或折叠思考过程">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Width="8" Height="8"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,5,0"
                                                                  Fill="{DynamicResource AccentBrush}"
                                                                  Data="M 0,0 L 8,0 L 4,5 Z">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                                                                <Setter Property="RenderTransform">
                                                                                    <Setter.Value>
                                                                                        <RotateTransform CenterX="4" CenterY="2.5" Angle="-90" />
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                     <TextBlock Text="{Binding ReasoningSummary}"
                                                                Foreground="{DynamicResource AccentBrush}"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                FontFamily="Consolas">
                                                                 <TextBlock.Style>
                                                                     <Style TargetType="TextBlock">
                                                                         <Setter Property="Text" Value="{Binding ReasoningSummary}" />
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding IsThinkingActive}" Value="True">
                                                                                 <Setter Property="Text" Value="{Binding DataContext.Conversation.ThinkingTimerText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                             </DataTrigger>
                                                                             <DataTrigger Binding="{Binding ReasoningSummary}" Value="{x:Static system:String.Empty}">
                                                                                 <Setter Property="Text" Value="{Binding ReasoningDurationText}" />
                                                                             </DataTrigger>
                                                                             <DataTrigger Binding="{Binding ReasoningDurationText}" Value="{x:Static system:String.Empty}">
                                                                                 <Setter Property="Text" Value="思考" />
                                                                             </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <TextBlock Text="{Binding ReasoningText}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11"
                                                               LineHeight="16"
                                                               MaxHeight="180"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,5,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsReasoningExpanded}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding HasVisibleReasoning}" Value="True" />
                                                                    <Condition Binding="{Binding DataContext.Conversation.ShowReasoning, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding RoleLabel}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="10"
                                                       FontFamily="Consolas" />
                                            <Border BorderThickness="{Binding BubbleBorderThickness}"
                                                     BorderBrush="{DynamicResource BorderStrongBrush}"
                                                     CornerRadius="8"
                                                     Padding="9,6"
                                                     Background="{Binding BubbleBackground}"
                                                     Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Text}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="13" />
                                            </Border>
                                        </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Conversation.TodoProposals}" Margin="0,4,0,9">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <views:TodoProposalCard />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Conversation.ArchiveDrafts}" Margin="0,4,0,9">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <views:ArchiveDraftCard />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding Conversation.RequestStatusText}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,2" />
                            <TextBlock x:Name="ErrorText"
                                       Text="{Binding Conversation.ErrorText}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,4" />
                            <Button Content="检查模型连接设置"
                                    Command="{Binding Conversation.OpenSettingsCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="8,4"
                                    Margin="0,0,0,5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsSecondaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Conversation.ErrorText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Conversation.ErrorText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Conversation.ErrorText}" Value="对话服务暂时不可用：请检查模型连接设置后重试。">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Button x:Name="JumpToLatestButton"
                            Click="OnJumpToLatestClick"
                            Style="{StaticResource SettingsSecondaryButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,16,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Visibility="Collapsed"
                            Content="↓ 回到底部" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="InputBox"
                             Style="{StaticResource SettingsTextBoxStyle}"
                             MinHeight="88"
                             MaxHeight="120"
                             Padding="10,9"
                             FontSize="13"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MaxLength="12000"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Conversation.InputText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="输入消息；Enter 发送，Shift+Enter 换行"
                             automation:AutomationProperties.Name="对话输入">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Conversation.SendCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock IsHitTestVisible="False"
                               Margin="10,9"
                               Text="输入消息；Enter 发送，Shift+Enter 换行"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Conversation.InputText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch">
                    <Button x:Name="SendButton"
                            IsEnabled="{Binding Conversation.CanSendOrStop}"
                            Command="{Binding Conversation.SendOrStopCommand}"
                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                            Padding="14,10"
                            VerticalAlignment="Stretch"
                            ToolTip="{Binding Conversation.ActionLabel}"
                            automation:AutomationProperties.Name="{Binding Conversation.ActionLabel}">
                        <TextBlock Text="{Binding Conversation.ActionLabel}" />
                    </Button>
                    <Button Content="模型设置"
                            Command="{Binding Conversation.OpenSettingsCommand}"
                            Style="{StaticResource SettingsSecondaryButtonStyle}"
                            Padding="14,4"
                            Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,6,0,0" MinHeight="28">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="5,1">
                        <TextBlock Text="{Binding Conversation.ProviderStatusText}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="10"
                                   FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="160" />
                    </Border>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="5,1"
                            Margin="6,0,0,0">
                        <TextBlock Text="{Binding Conversation.ModelStatusText}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="10"
                                   FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="200" />
                    </Border>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,0,2"
                           Text="CHALDEA LINK · SERVANT CHANNEL"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           FontSize="9"
                           FontFamily="Consolas" />
            </Grid>
        </Grid>
    </Grid>
</Window>
