<UserControl x:Class="FgoPet.App.Panels.AttachedPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             FontFamily="Segoe UI, Microsoft YaHei UI"
             Foreground="{DynamicResource ShellTextBrush}"
             UseLayoutRounding="True"
             MouseEnter="OnPointerEntered"
             MouseLeave="OnPointerLeft">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FgoPet.App;component/Ui/Shell/ShellTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <StreamGeometry x:Key="PetChatIcon">M2,2.5 H14 V10.5 H7 L3.5,13.5 V10.5 H2 Z M5,5.5 H11 M5,7.8 H9</StreamGeometry>
            <StreamGeometry x:Key="PetSpeechIcon">M2,6 H5 L9,2 V14 L5,10 H2 Z M11,5 C13,6.5 13,9.5 11,11 M13,3 C16,5.5 16,10.5 13,13</StreamGeometry>
            <StreamGeometry x:Key="PetMoreIcon">M3,8 A1,1 0 1 0 3,8.1 M8,8 A1,1 0 1 0 8,8.1 M13,8 A1,1 0 1 0 13,8.1</StreamGeometry>
            <StreamGeometry x:Key="PetSettingsIcon">M8,5.5 A2.5,2.5 0 1 0 8,10.5 A2.5,2.5 0 1 0 8,5.5 M8,1.5 V3 M8,13 V14.5 M1.5,8 H3 M13,8 H14.5 M3.4,3.4 L4.5,4.5 M11.5,11.5 L12.6,12.6 M12.6,3.4 L11.5,4.5 M4.5,11.5 L3.4,12.6</StreamGeometry>
            <StreamGeometry x:Key="PetTaskIcon">M2,3 L4,5 L7,2 M9,4 H14 M2,9 L4,11 L7,8 M9,10 H14 M2,14 L4,16 L7,13 M9,15 H14</StreamGeometry>
            <StreamGeometry x:Key="PetFocusIcon">M8,3 A5,5 0 1 0 8,13 A5,5 0 1 0 8,3 M8,5.5 V8 L10.5,9.5 M6,1.5 H10 M11.5,3 L12.5,2</StreamGeometry>
            <StreamGeometry x:Key="PetPlayIcon">M5,3 L12,8 L5,13 Z</StreamGeometry>
            <StreamGeometry x:Key="PetPauseIcon">M5,3 V13 M11,3 V13</StreamGeometry>
            <StreamGeometry x:Key="PetStopIcon">M3.5,3.5 H12.5 V12.5 H3.5 Z</StreamGeometry>
            <StreamGeometry x:Key="PetExitIcon">M8,1.5 V8 M4,3.5 A6,6 0 1 0 12,3.5</StreamGeometry>

            <DataTemplate x:Key="PetIconTemplate">
                <Viewbox Width="16" Height="16" Stretch="Uniform">
                    <Path Data="{Binding}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Fill="Transparent" />
                </Viewbox>
            </DataTemplate>

            <DataTemplate x:Key="PetSolidIconTemplate">
                <Viewbox Width="16" Height="16" Stretch="Uniform">
                    <Path Data="{Binding}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Viewbox>
            </DataTemplate>

            <Style x:Key="PetEntryButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="9" />
                <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
                <Setter Property="Background" Value="{DynamicResource ShellWindowBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ShellLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ShellRaisedBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PetFluentEntryButtonStyle" TargetType="Button" BasedOn="{StaticResource PetEntryButtonStyle}">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Padding" Value="7" />
            </Style>

            <Style x:Key="PetDialAdjustButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PetFocusPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PetEntryButtonStyle}">
                <Setter Property="Width" Value="70" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="Foreground" Value="{DynamicResource ShellWindowBrush}" />
                <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="PetDialChevronButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource ShellMutedBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PetDialStartButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource ShellWindowBrush}" />
                <Setter Property="Background" Value="{DynamicResource ShellAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="26">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ShellRaisedBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ToolTip}">
                <Setter Property="Placement" Value="Right" />
                <Setter Property="HorizontalOffset" Value="8" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource ShellWindowBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ShellLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HasDropShadow" Value="False" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid ClipToBounds="True" SnapsToDevicePixels="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="CardSurface"
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Top"
                Background="{DynamicResource ShellPanelBackgroundBrush}"
                BorderBrush="{DynamicResource ShellAccentBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Width="220"
                HorizontalAlignment="Left"
                Padding="6">
            <Grid>
                <TextBlock x:Name="PanelTitle" Text="桌宠" Visibility="Collapsed" />


                <Grid x:Name="FocusSetupCard" Width="196" Height="196" Visibility="Collapsed">
                    <Ellipse Fill="{DynamicResource ShellWindowBrush}"
                             Stroke="{DynamicResource ShellAccentBrush}"
                             StrokeThickness="3"
                             Opacity="0.85" />
                    <Ellipse Margin="8"
                             Stroke="{DynamicResource ShellLineBrush}"
                             StrokeThickness="4"
                             Opacity="0.7" />
                    <Grid Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                            <TextBlock Text="循环"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource ShellTextBrush}"
                                       FontSize="11" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="‹" Tag="CyclesDown" Click="OnFocusAdjustClick" Style="{StaticResource PetDialChevronButtonStyle}" />
                                <TextBlock Text="{Binding CustomCyclesText}"
                                           MinWidth="24"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource ShellTextBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <Button Content="›" Tag="CyclesUp" Click="OnFocusAdjustClick" Style="{StaticResource PetDialChevronButtonStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="专注"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource ShellTextBrush}"
                                           FontSize="11" />
                                <Grid Width="62" Height="62" Margin="0,1,0,0">
                                    <Ellipse Fill="{DynamicResource ShellPanelBackgroundBrush}"
                                             Stroke="{DynamicResource ShellLineBrush}"
                                             StrokeThickness="2" />
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Content="⌃" Tag="FocusUp" Click="OnFocusAdjustClick" Style="{StaticResource PetDialChevronButtonStyle}" />
                                        <TextBlock Text="{Binding CustomFocusMinutesText}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource ShellTextBrush}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <Button Content="⌄" Tag="FocusDown" Click="OnFocusAdjustClick" Style="{StaticResource PetDialChevronButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="休息"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource ShellTextBrush}"
                                           FontSize="11" />
                                <Grid Width="62" Height="62" Margin="0,1,0,0">
                                    <Ellipse Fill="{DynamicResource ShellPanelBackgroundBrush}"
                                             Stroke="{DynamicResource ShellLineBrush}"
                                             StrokeThickness="2" />
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Content="⌃" Tag="BreakUp" Click="OnFocusAdjustClick" Style="{StaticResource PetDialChevronButtonStyle}" />
                                        <TextBlock Text="{Binding CustomBreakMinutesText}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource ShellTextBrush}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <Button Content="⌄" Tag="BreakDown" Click="OnFocusAdjustClick" Style="{StaticResource PetDialChevronButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="StartFocusButton"
                                Grid.Row="2"
                                Content="{StaticResource PetPlayIcon}"
                                ContentTemplate="{StaticResource PetSolidIconTemplate}"
                                Click="OnStartFocusClick"
                                ToolTip="开始专注"
                                automation:AutomationProperties.Name="开始专注"
                                Style="{StaticResource PetDialStartButtonStyle}" />
                    </Grid>
                </Grid>
                <Grid x:Name="CompactTimer" Width="196" Height="196" Visibility="Collapsed">
                    <Ellipse Fill="{DynamicResource ShellWindowBrush}"
                             Stroke="{DynamicResource ShellLineBrush}"
                             StrokeThickness="1" />
                    <Ellipse Margin="5"
                             Stroke="{DynamicResource ShellLineBrush}"
                             StrokeThickness="5"
                             Opacity="0.55" />
                    <Path x:Name="FocusProgressArc"
                          Width="186" Height="186"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource ShellAccentBrush}"
                          StrokeThickness="5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent" />
                    <Grid Margin="14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock x:Name="CompactPhaseText"
                                       Text="{Binding PhaseText}"
                                       Foreground="{DynamicResource ShellAccentBrush}"
                                       FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="CompactCycleText"
                                       Text="{Binding CycleText}"
                                       Foreground="{DynamicResource ShellMutedBrush}"
                                       FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding RemainingText}"
                                   Foreground="{DynamicResource ShellTextBrush}"
                                   FontFamily="Consolas"
                                   FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button x:Name="PauseResumeButton"
                                    Content="{StaticResource PetPauseIcon}"
                                    ContentTemplate="{StaticResource PetIconTemplate}"
                                    ToolTip="暂停专注"
                                    automation:AutomationProperties.Name="暂停专注"
                                    Click="OnPauseResumeClick"
                                    Style="{StaticResource PetEntryButtonStyle}" />
                            <Button x:Name="StopTimerButton"
                                    Content="{StaticResource PetStopIcon}"
                                    ContentTemplate="{StaticResource PetIconTemplate}"
                                    ToolTip="结束专注"
                                    automation:AutomationProperties.Name="结束专注"
                                    Click="OnStopTimerClick"
                                    Style="{StaticResource PetEntryButtonStyle}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

            </Grid>
        </Border>

        <StackPanel Grid.Column="0" VerticalAlignment="Top">
            <StackPanel x:Name="CompanionControlIsland" Orientation="Vertical" HorizontalAlignment="Left">
                <Grid>
                    <Button x:Name="ChatEntryButton"
                            Content="{StaticResource PetChatIcon}"
                            ContentTemplate="{StaticResource PetIconTemplate}"
                            ToolTip="聊天"
                            automation:AutomationProperties.Name="聊天"
                            Click="OnDialogueClick"
                            Style="{StaticResource PetEntryButtonStyle}" />
                    <Border x:Name="DialogueUnreadBadge"
                            Background="{DynamicResource ShellAccentBrush}"
                            CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                        <TextBlock Text="{Binding DialogueUnreadCount}"
                                   Foreground="{DynamicResource ShellWindowBrush}"
                                   FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDialogueUnread}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
                <Button x:Name="SpeechEntryButton"
                        Content="{StaticResource PetSpeechIcon}"
                        ContentTemplate="{StaticResource PetIconTemplate}"
                        ToolTip="朗读"
                        automation:AutomationProperties.Name="朗读"
                        Click="OnSpeechClick"
                        Margin="0,8,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PetEntryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAutoReadEnabled}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}" />
                                    <Setter Property="Background" Value="{DynamicResource ShellAccentSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="MoreEntryButton"
                        Content="{StaticResource PetMoreIcon}"
                        ContentTemplate="{StaticResource PetIconTemplate}"
                        ToolTip="更多"
                        automation:AutomationProperties.Name="更多"
                        Click="OnToggleQuickActions"
                        Style="{StaticResource PetEntryButtonStyle}"
                        Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel x:Name="CompactActions" Orientation="Vertical" Margin="0,8,0,0" Visibility="Collapsed">
                <Button x:Name="SettingsEntryButton"
                        Content="&#xE713;"
                        ToolTip="设置"
                        automation:AutomationProperties.Name="设置"
                        Click="OnSettingsClick"
                        Style="{StaticResource PetFluentEntryButtonStyle}" />
                <Button x:Name="TasksEntryButton"
                        Content="{StaticResource PetTaskIcon}"
                        ContentTemplate="{StaticResource PetIconTemplate}"
                        ToolTip="任务"
                        automation:AutomationProperties.Name="任务"
                        Click="OnTasksClick"
                        Style="{StaticResource PetEntryButtonStyle}"
                        Margin="0,8,0,0" />
                <Button x:Name="FocusEntryButton"
                        Content="&#xE823;"
                        ToolTip="专注"
                        automation:AutomationProperties.Name="专注"
                        Click="OnFocusClick"
                        Style="{StaticResource PetFluentEntryButtonStyle}"
                        Margin="0,8,0,0" />
                <Button x:Name="ExitEntryButton"
                        Content="{StaticResource PetExitIcon}"
                        ContentTemplate="{StaticResource PetIconTemplate}"
                        ToolTip="退出"
                        automation:AutomationProperties.Name="退出"
                        Click="OnExitClick"
                        Style="{StaticResource PetEntryButtonStyle}"
                        Margin="0,8,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
