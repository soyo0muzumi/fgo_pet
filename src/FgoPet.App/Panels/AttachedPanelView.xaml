<UserControl x:Class="FgoPet.App.Panels.AttachedPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI"
             MouseEnter="OnPointerEntered" MouseLeave="OnPointerLeft">
    <UserControl.Resources>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Foreground" Value="#FF70E7F5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>
    <Grid ClipToBounds="True" SnapsToDevicePixels="True">
        <Border Background="#E8172238" BorderBrush="#CC42DFF5" BorderThickness="1" />
        <Grid Margin="12,9">
            <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <TextBlock x:Name="PanelTitle" Text="CHALDEA // PERSONAL LINK" Foreground="#FF70E7F5"
                           FontSize="10" FontWeight="SemiBold" />
                <StackPanel x:Name="CompactActions" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="对话" Click="OnDialogueClick" Style="{StaticResource LinkButton}" />
                    <Button Content="TODO" Click="OnTodoClick" Style="{StaticResource LinkButton}" Foreground="#FFD242E8" />
                    <Button x:Name="CollapseButton" Content="收起" Click="OnCollapseClick" Style="{StaticResource LinkButton}" />
                </StackPanel>
                <Rectangle Height="2" VerticalAlignment="Bottom" Fill="#FFD242E8" />
            </Grid>
            <TextBlock x:Name="CompactMessage" Grid.Row="1" Margin="0,8,0,0"
                       Text="前辈，今天也请按自己的节奏来。" TextWrapping="Wrap"
                       Foreground="#FFF0F5FF" FontSize="13" />
            <ScrollViewer x:Name="DialogueContent" Grid.Row="1" Margin="0,8,0,0"
                          Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Dialogue}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="WrapWithOverflow"
                                   Foreground="#FFF0F5FF" FontSize="13" Margin="0,0,0,5" />
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ScrollViewer x:Name="TodoContent" Grid.Row="1" Margin="0,8,0,0"
                          Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Todo}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="WrapWithOverflow"
                                   Foreground="#FFF0F5FF" FontSize="13" MaxHeight="40" Margin="0,0,0,5" />
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
