<UserControl x:Class="FgoPet.App.Panels.AttachedPanelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI, Microsoft YaHei UI" MouseEnter="OnPointerEntered" MouseLeave="OnPointerLeft">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Cyan" Color="#FF70E7F5"/><SolidColorBrush x:Key="Mag" Color="#FFD242E8"/><SolidColorBrush x:Key="Text" Color="#FFF0F5FF"/><SolidColorBrush x:Key="Muted" Color="#FF9FB2D8"/>
    <Style x:Key="LinkButton" TargetType="Button"><Setter Property="Padding" Value="5,3"/><Setter Property="Foreground" Value="{StaticResource Cyan}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="PresetButton" TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="#990B1424"/><Setter Property="BorderBrush" Value="#FF38516C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="5,7"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="FontSize" Value="10"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="StepButton" TargetType="Button"><Setter Property="Width" Value="31"/><Setter Property="Background" Value="#FF142A3C"/><Setter Property="Foreground" Value="{StaticResource Cyan}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="17"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="StepTextBox" TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="1,0"/><Setter Property="BorderBrush" Value="#FF314C63"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="PrimaryActionButton" TargetType="Button"><Setter Property="Background" Value="#2642DFF5"/><Setter Property="BorderBrush" Value="#CC42DFF5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{StaticResource Cyan}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="13,8"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="FieldError" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Mag}"/><Setter Property="FontSize" Value="9"/></Style>
  </UserControl.Resources>
  <Grid ClipToBounds="True" SnapsToDevicePixels="True">
    <Border Background="#F217243B" BorderBrush="#FF42DFF5" BorderThickness="1.5"/>
    <Grid Margin="14,10"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="PanelTitle" Text="CHALDEA LINK" Foreground="{StaticResource Cyan}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
        <StackPanel x:Name="CompactActions" Grid.Column="1" Orientation="Horizontal"><Button x:Name="FocusButton" Content="专注" Click="OnFocusClick" Style="{StaticResource LinkButton}"/><Button x:Name="TodayButton" Content="今日" Click="OnTodayClick" Style="{StaticResource LinkButton}"/><Button x:Name="TodoButton" Content="TODO" Click="OnTodoClick" Style="{StaticResource LinkButton}"/><Button x:Name="DialogueButton" Content="对话" Click="OnDialogueClick" Style="{StaticResource LinkButton}"/></StackPanel>
        <Grid Grid.ColumnSpan="2" Height="3" VerticalAlignment="Bottom" Background="#4438516C"><Border Width="72" HorizontalAlignment="Left" Background="{StaticResource Mag}"/></Grid>
      </Grid>
      <Grid Grid.Row="1" Margin="4,11,4,2">
        <Grid x:Name="CompactMessage"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="LOCAL COMPANION" Foreground="{StaticResource Cyan}" FontSize="9"/><TextBlock Text="前辈，今天也请按自己的节奏来。" TextWrapping="Wrap" Foreground="{StaticResource Text}" FontSize="14" Margin="0,7,8,0"/></StackPanel><Border Grid.Column="1" BorderBrush="{StaticResource Mag}" BorderThickness="2,0,0,0" Padding="9,3,0,3" VerticalAlignment="Center"><TextBlock Text="READY&#x0a;本地待命" Foreground="{StaticResource Muted}" FontSize="9"/></Border></Grid>
        <Grid x:Name="CompactTimer" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><TextBlock x:Name="CompactPhaseText" Text="{Binding PhaseText}" Foreground="{StaticResource Cyan}" FontSize="11"/><TextBlock x:Name="CompactCycleText" Text="{Binding CycleText}" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"/></Grid>
          <TextBlock Grid.Row="1" Text="{Binding RemainingText}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="30" FontWeight="Bold" Margin="0,4,0,7"/>
          <ProgressBar x:Name="TimerProgress" Grid.Row="2" Value="{Binding ProgressPercent}" Maximum="100" Height="6" Background="#FF293C51" Foreground="{StaticResource Cyan}"/>
          <Grid Grid.Row="3" Margin="0,7,0,0"><TextBlock Text="{Binding TimerMetaText}" Foreground="{StaticResource Muted}" FontSize="9"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="PauseResumeButton" Content="暂停" Click="OnPauseResumeClick" Style="{StaticResource LinkButton}"/><Button x:Name="StopTimerButton" Content="退出" Click="OnStopTimerClick" Style="{StaticResource LinkButton}" Foreground="#FFEF9BE9"/></StackPanel></Grid>
        </Grid>
        <ScrollViewer x:Name="FocusContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="FOCUS PROTOCOL / 专注方案" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/><Border Grid.Column="1" Height="1" Background="#9942DFF5" Margin="9,0,0,0" VerticalAlignment="Center"/></Grid>
          <Grid x:Name="PresetGrid" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="Preset25Button" Content="25 / 5&#x0a;4 轮" Click="OnPreset25Click" Style="{StaticResource PresetButton}"/><Button x:Name="Preset50Button" Grid.Column="1" Content="50 / 10&#x0a;2 轮" Click="OnPreset50Click" Style="{StaticResource PresetButton}"/><Button x:Name="CustomPresetButton" Grid.Column="2" Content="CUSTOM&#x0a;自定义" Click="OnCustomPresetClick" Style="{StaticResource PresetButton}" Margin="0"/></Grid>
          <StackPanel x:Name="CustomPresetFields" Visibility="Collapsed">
            <Grid Margin="0,0,0,7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="专注时长" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><Border Grid.Column="1" Height="34" BorderBrush="#FF42647D" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/><ColumnDefinition Width="31"/></Grid.ColumnDefinitions><Button x:Name="CustomFocusMinusButton" Content="−" Click="OnCustomFocusMinusClick" Style="{StaticResource StepButton}"/><TextBox x:Name="CustomFocusMinutesBox" Grid.Column="1" Text="{Binding CustomFocusMinutesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepTextBox}"/><Button x:Name="CustomFocusPlusButton" Grid.Column="2" Content="＋" Click="OnCustomFocusPlusClick" Style="{StaticResource StepButton}"/></Grid></Border><TextBlock Grid.Row="1" Grid.Column="1" Text="5–180 分钟 · 步进 5" Foreground="#FF6F87A6" FontSize="8" Margin="0,3,0,0"/></Grid><TextBlock Text="{Binding CustomFocusError}" Style="{StaticResource FieldError}"/>
            <Grid Margin="0,3,0,7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="休息时长" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><Border Grid.Column="1" Height="34" BorderBrush="#FF42647D" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/><ColumnDefinition Width="31"/></Grid.ColumnDefinitions><Button Content="−" Click="OnCustomBreakMinusClick" Style="{StaticResource StepButton}"/><TextBox x:Name="CustomBreakMinutesBox" Grid.Column="1" Text="{Binding CustomBreakMinutesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepTextBox}"/><Button Grid.Column="2" Content="＋" Click="OnCustomBreakPlusClick" Style="{StaticResource StepButton}"/></Grid></Border><TextBlock Grid.Row="1" Grid.Column="1" Text="1–60 分钟 · 步进 5" Foreground="#FF6F87A6" FontSize="8" Margin="0,3,0,0"/></Grid><TextBlock Text="{Binding CustomBreakError}" Style="{StaticResource FieldError}"/>
            <Grid Margin="0,3,0,7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="循环轮次" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/><Border Grid.Column="1" Height="34" BorderBrush="#FF42647D" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/><ColumnDefinition Width="31"/></Grid.ColumnDefinitions><Button Content="−" Click="OnCustomCyclesMinusClick" Style="{StaticResource StepButton}"/><TextBox x:Name="CustomCyclesBox" Grid.Column="1" Text="{Binding CustomCyclesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StepTextBox}"/><Button Grid.Column="2" Content="＋" Click="OnCustomCyclesPlusClick" Style="{StaticResource StepButton}"/></Grid></Border><TextBlock Grid.Row="1" Grid.Column="1" Text="1–12 轮 · 步进 1" Foreground="#FF6F87A6" FontSize="8" Margin="0,3,0,0"/></Grid><TextBlock Text="{Binding CustomCyclesError}" Style="{StaticResource FieldError}"/>
          </StackPanel>
          <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="预计总时长 · 最后一轮后无休息" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock Text="{Binding CustomTotalText}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="17" FontWeight="Bold"/></StackPanel><Button x:Name="StartFocusButton" Grid.Column="1" Content="开始专注" Click="OnStartFocusClick" IsEnabled="{Binding CanStartFocus}" Style="{StaticResource PrimaryActionButton}"/></Grid>
        </StackPanel></ScrollViewer>
        <ScrollViewer x:Name="TodayContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Grid Margin="0,0,0,8"><TextBlock Text="TODAY / 今日记录" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding TodayEffectiveText}" Foreground="{StaticResource Mag}" FontSize="11" HorizontalAlignment="Right"/></Grid><TextBlock Foreground="{StaticResource Text}" FontSize="12"><Run Text="羁绊 Lv. "/><Run Text="{Binding BondLevelText}"/></TextBlock><TextBlock Text="{Binding BondRemainingText}" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,8"/><ItemsControl ItemsSource="{Binding Today}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeText}" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding SummaryText}" Foreground="{StaticResource Text}" Margin="5,0"/><TextBlock Grid.Column="2" Text="{Binding BondLevelText}" Foreground="{StaticResource Mag}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="TodoContent" Visibility="Collapsed"><StackPanel><TextBlock Text="TODO LINK / 接口待命" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold"/><TextBlock Text="等待后续 Agent 接入" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,8,0,0"/><ItemsControl ItemsSource="{Binding Todo}"/></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="DialogueContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid Margin="0,0,0,7">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="DIALOGUE / 对话" Foreground="{StaticResource Cyan}" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="CHALDEA LINK · SERVANT CHANNEL" Foreground="#FF6F87A6" FontSize="7" Margin="7,1,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border x:Name="DialogueProviderBadge" Background="#2642DFF5" BorderBrush="#8842DFF5" BorderThickness="1" CornerRadius="2" Padding="5,1">
                  <TextBlock Text="{Binding Conversation.ProviderStatusText}" Foreground="{StaticResource Cyan}" FontSize="8" FontFamily="Consolas"/>
                </Border>
                <Border x:Name="DialogueModelBadge" Margin="4,0,0,0" Background="#330B1424" BorderBrush="#FF38516C" BorderThickness="1" CornerRadius="2" Padding="5,1">
                  <TextBlock Text="{Binding Conversation.ModelStatusText}" Foreground="{StaticResource Muted}" FontSize="8" FontFamily="Consolas"/>
                </Border>
              </StackPanel>
            </Grid>

            <StackPanel x:Name="DialogueEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,26,0,10">
              <TextBlock Text="等待你的第一句话" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="从者频道已就绪。输入一句话开始对话。" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <Border x:Name="DialogueConfigurationCard" Background="#3314243B" BorderBrush="#88EF9DAF" BorderThickness="1" CornerRadius="2" Margin="0,0,0,7" Visibility="Collapsed">
              <Border BorderBrush="#EF9DAF" BorderThickness="2,0,0,0" Padding="9,8">
                <StackPanel>
                  <TextBlock Text="尚未配置模型连接" Foreground="#FFEF9DAF" FontSize="11" FontWeight="Bold"/>
                  <TextBlock Text="对话需要 OpenAI 格式的模型供应商。角色包与本地功能仍可离线使用。" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,8"/>
                  <Button x:Name="DialogueSettingsButton" Content="去设置 · AI 模型与连接" Click="OnDialogueSettingsClick" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Padding="9,5"/>
                </StackPanel>
              </Border>
            </Border>

            <ItemsControl x:Name="DialogueMessageList" ItemsSource="{Binding Conversation.Turns}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,7" HorizontalAlignment="{Binding Alignment}">
                    <TextBlock Text="{Binding RoleLabel}" Foreground="{Binding RoleBrush}" FontSize="8" FontFamily="Consolas" />
                    <Border BorderThickness="{Binding BubbleBorderThickness}" BorderBrush="{Binding BubbleBorderBrush}" CornerRadius="4" Padding="7,5" Background="{Binding BubbleBackground}" Margin="0,2,0,0">
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource Text}" FontSize="12" />
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="DialogueErrorText" Text="{Binding Conversation.ErrorText}" Foreground="{StaticResource Mag}" TextWrapping="Wrap" Margin="0,0,0,5" />

            <StackPanel x:Name="DialogueComposer" Margin="0,4,0,0">
              <TextBox x:Name="DialogueInputBox" Text="{Binding Conversation.InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="12000" MinHeight="48" VerticalScrollBarVisibility="Auto" />
              <Grid Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <Button x:Name="NewConversationButton" Content="新对话" Click="OnNewConversationClick" Style="{StaticResource LinkButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="StopDialogueButton" Content="停止" Click="OnStopDialogueClick" IsEnabled="{Binding Conversation.CanStop}" Style="{StaticResource LinkButton}" />
                  <Button x:Name="SendDialogueButton" Content="发送" Click="OnSendDialogueClick" IsEnabled="{Binding Conversation.CanSend}" Style="{StaticResource PrimaryActionButton}" Padding="12,5" Margin="7,0,0,0"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Viewbox x:Name="FocusFooterOrnament" Grid.Row="2" Height="18" Margin="0,5,0,0" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"><Canvas Width="300" Height="18"><Path Stroke="#A8B8945F" StrokeThickness="1" Data="M 2,13 L 50,13 L 58,9 L 112,9 L 119,13 L 181,13 L 188,9 L 242,9 L 250,13 L 298,13 M 136,13 A 14,14 0 0 1 164,13"/><Path Stroke="#8870E7F5" StrokeThickness="1" Data="M 150,0 L 150,18 M 138,13 L 138,9 M 162,13 L 162,9 M 126,13 L 126,10 M 174,13 L 174,10"/><Ellipse Canvas.Left="147" Canvas.Top="10" Width="6" Height="6" Stroke="#CCD242E8"/></Canvas></Viewbox>
      <Viewbox x:Name="GeneralFooterOrnament" Grid.Row="2" Height="13" Margin="0,5,0,0" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False"><Canvas Width="300" Height="13"><Path Stroke="#8870E7F5" StrokeThickness="1" Data="M 2,8 L 34,8 L 40,4 L 94,4 L 99,8 L 137,8 L 143,4 L 157,4 L 163,8 L 201,8 L 206,4 L 260,4 L 266,8 L 298,8"/><Path Stroke="#88B8945F" StrokeThickness="1" Data="M 2,11 L 71,11 M 229,11 L 298,11 M 147,3 L 150,0 L 153,3 L 150,6 Z"/></Canvas></Viewbox>
    </Grid>
  </Grid>
</UserControl>
