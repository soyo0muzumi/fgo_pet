<UserControl x:Class="FgoPet.App.Panels.AttachedPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI"
             MouseEnter="OnPointerEntered"
             MouseLeave="OnPointerLeft">
    <Grid ClipToBounds="True" SnapsToDevicePixels="True">
        <Path Fill="#E8172238" Stroke="#CC42DFF5" StrokeThickness="1" Stretch="Fill"
              Data="M 16,0 L 204,0 L 220,16 L 220,84 L 204,100 L 16,100 L 0,84 L 0,16 Z" />
        <Grid Margin="12,9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
                <TextBlock x:Name="PanelTitle" Text="CHALDEA // PERSONAL LINK"
                           Foreground="#FF70E7F5" FontSize="10" FontWeight="SemiBold" />
                <Button x:Name="CollapseButton" DockPanel.Dock="Right" Content="收起" Click="OnCollapseClick"
                        Padding="6,1" Foreground="#FFF0F5FF" Background="#40203A4A"
                        BorderBrush="#8066E0FF" />
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Rectangle Height="2" VerticalAlignment="Bottom" Fill="#FFD242E8" />
                <StackPanel x:Name="CompactActions" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="对话" Click="OnDialogueClick" MinWidth="64" Margin="0,0,6,0"
                        Foreground="#66E0FF" Background="#40203A4A" BorderBrush="#8066E0FF" />
                <Button Content="Todo" Click="OnTodoClick" MinWidth="64"
                        Foreground="#FF66CC" Background="#40203A4A" BorderBrush="#80FF66CC" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="CompactMessage" Grid.Row="2"
                       Text="前辈，今天也请按自己的节奏来。"
                       TextWrapping="Wrap" Foreground="#FFF0F5FF" FontSize="13" />
            <StackPanel x:Name="DialogueContent" Grid.Row="2" Visibility="Collapsed">
                <TextBlock Text="对话" FontWeight="Bold" Foreground="#66E0FF" Margin="0,0,0,6" />
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Dialogue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="WrapWithOverflow"
                                           Foreground="#FFF6E0" Margin="0,0,0,5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
            <StackPanel x:Name="TodoContent" Grid.Row="2" Visibility="Collapsed">
                <TextBlock Text="Todo" FontWeight="Bold" Foreground="#FF66CC" Margin="0,0,0,6" />
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Todo}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="WrapWithOverflow"
                                           Foreground="#FFF6E0" MaxHeight="40" Margin="0,0,0,5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
