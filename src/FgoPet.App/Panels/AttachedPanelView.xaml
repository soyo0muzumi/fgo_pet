<UserControl x:Class="FgoPet.App.Panels.AttachedPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#E0102633">
    <StackPanel Margin="8">
        <TextBlock Text="对话" FontWeight="Bold" Foreground="#66E0FF" />
        <ItemsControl ItemsSource="{Binding Dialogue}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#FFF6E0" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="待办" FontWeight="Bold" Foreground="#FF66CC" Margin="0,8,0,0" />
        <ItemsControl ItemsSource="{Binding Todo}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#FFF6E0" MaxHeight="40" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>