<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ShellTokens.xaml"/></ResourceDictionary.MergedDictionaries>
<StreamGeometry x:Key="ChatHistory">M2,3 H14 M2,8 H14 M2,13 H14</StreamGeometry>
<StreamGeometry x:Key="ChatTasks">M2,3 L4,5 L7,2 M9,4 H14 M2,9 L4,11 L7,8 M9,10 H14 M2,14 L4,16 L7,13 M9,15 H14</StreamGeometry>
<StreamGeometry x:Key="ChatNew">M8,2 V14 M2,8 H14</StreamGeometry>
<StreamGeometry x:Key="ChatClose">M3,3 L13,13 M13,3 L3,13</StreamGeometry>
<StreamGeometry x:Key="ChatHide">M3,6 L8,11 L13,6</StreamGeometry>
<StreamGeometry x:Key="ChatSend">M8,14 V2 M3,7 L8,2 L13,7</StreamGeometry>
<StreamGeometry x:Key="ChatStop">M3,3 H13 V13 H3 Z</StreamGeometry>
<StreamGeometry x:Key="ChatBubble">M3,2 H13 Q15,2 15,4 V10 Q15,12 13,12 H7 L3,15 V12 Q1,12 1,10 V4 Q1,2 3,2</StreamGeometry>
<StreamGeometry x:Key="ChatFocus">M6,1 H10 M8,1 V3 M12,4 L14,2 M8,4 A5,5 0 1 1 8,14 A5,5 0 1 1 8,4 M8,6 V9 L10,10</StreamGeometry>
<StreamGeometry x:Key="ChatSettings">M2,3 H14 M2,8 H14 M2,13 H14 M5,1 V5 M11,6 V10 M6,11 V15</StreamGeometry>
<StreamGeometry x:Key="ChatPerson">M8,2 A3,3 0 1 1 8,8 A3,3 0 1 1 8,2 M2,15 V13 Q2,10 8,10 Q14,10 14,13 V15</StreamGeometry>
<DataTemplate x:Key="ChatIcon"><Grid Width="16" Height="16"><Path Data="{Binding}" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Grid></DataTemplate>
<Style x:Key="ChatButton" TargetType="Button">
<Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="8"/>
<Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/><Setter Property="Background" Value="{DynamicResource Surface.Subtle}"/><Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border x:Name="FocusOutline" BorderBrush="{DynamicResource Focus.Ring}" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Hover}"/><Setter Property="Foreground" Value="{DynamicResource Action.Primary}"/></Trigger>
<Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Pressed}"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/></Trigger>
<Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<StreamGeometry x:Key="ChatCopy">M6,5 V2 H14 V10 H11 M2,6 H10 V14 H2 Z</StreamGeometry>
<StreamGeometry x:Key="ChatCopied">M2,8 L6,12 L14,4</StreamGeometry>
<StreamGeometry x:Key="ChatCopyFailed">M8,2 V9 M8,12 V14</StreamGeometry>
<StreamGeometry x:Key="ChatSpeak">M2,6 H5 L8,3 V13 L5,10 H2 Z M11,5 Q14,8 11,11 M13,2 Q18,8 13,14</StreamGeometry>
<Style x:Key="ChatMessageAction" TargetType="Button" BasedOn="{StaticResource ChatButton}">
<Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="7"/>
<Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
<Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
<Setter Property="ContentTemplate" Value="{StaticResource ChatIcon}"/>
<Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
</Style>
<Style x:Key="ChatTextButton" TargetType="Button" BasedOn="{StaticResource ChatButton}"><Setter Property="Width" Value="Auto"/><Setter Property="Padding" Value="12,6"/></Style>
<Style x:Key="ShellRailButton" TargetType="Button" BasedOn="{StaticResource ChatButton}">
<Setter Property="Width" Value="48"/><Setter Property="Height" Value="54"/><Setter Property="Padding" Value="4,7"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/><Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
<Setter Property="ContentTemplate"><Setter.Value><DataTemplate><StackPanel><Path Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><TextBlock Text="{Binding}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel></DataTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="ShellRailSelectedButton" TargetType="Button" BasedOn="{StaticResource ShellRailButton}"><Setter Property="Background" Value="{DynamicResource Surface.Content}"/><Setter Property="Foreground" Value="{DynamicResource Action.Primary}"/></Style>
<Style x:Key="ShellExpanderHeader" TargetType="ToggleButton">
<Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid>
<Border x:Name="HeaderChrome" Background="{TemplateBinding Background}" Padding="0,4" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/><Path x:Name="Chevron" Grid.Column="1" Data="{StaticResource ChatHide}" Width="10" Height="7" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/></Grid></Border>
<Border x:Name="HeaderFocus" BorderBrush="{DynamicResource Focus.Ring}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False"/>
</Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource Surface.Hover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderFocus" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="ShellExpander" TargetType="Expander">
<Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ToggleButton Style="{StaticResource ShellExpanderHeader}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
<ContentPresenter x:Name="ExpandedContent" Grid.Row="1" ContentSource="Content" Visibility="Collapsed" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
</Grid><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource ShellWindowBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,5"/></Style>
<Style x:Key="ChatInput" TargetType="TextBox"><Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}"/><Setter Property="SelectionBrush" Value="{DynamicResource Action.Primary}"/><Setter Property="SelectionOpacity" Value="0.3"/><Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="ChatHistoryItem" TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="8" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ShellAccentSoftBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ShellRaisedBackgroundBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
