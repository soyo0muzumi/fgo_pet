<Project Sdk="Microsoft.NET.Sdk">

  <!-- 阶段 1 项目拆分：条目由 src/FgoPet.App 迁出。 -->
  <!-- Include 相对本 csproj；Link 逐字沿用（决定 WPF 资源 URI 与生成类命名空间）。 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FgoPet.App</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FgoPet.App.Tests" />
    <InternalsVisibleTo Include="FgoPet.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../modules/character/src/FgoPet.Character/FgoPet.Character.csproj" />
    <ProjectReference Include="../../../../src/FgoPet.Core/FgoPet.Core.csproj" />
    <ProjectReference Include="../../../../host/DesktopShell/src/FgoPet.HostContracts/FgoPet.HostContracts.csproj" />
    <ProjectReference Include="../../../Settings/src/FgoPet.SettingsHost/FgoPet.SettingsHost.csproj" />
    <ProjectReference Include="../../../../modules/dialogue/src/FgoPet.Dialogue/FgoPet.Dialogue.csproj" />
    <ProjectReference Include="../../../../modules/memory/src/FgoPet.Memory/FgoPet.Memory.csproj" />
    <ProjectReference Include="../../../../src/FgoPet.Infrastructure/FgoPet.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Application\AppMaintenanceCoordinator.cs">
      <Link>host\DataManagement\Application\AppMaintenanceCoordinator.cs</Link>
    </Compile>
    <Compile Include="..\..\Application\DataClearService.cs">
      <Link>host\DataManagement\Application\DataClearService.cs</Link>
    </Compile>
    <Compile Include="..\..\Application\PrivateBackupRestoreService.cs">
      <Link>host\DataManagement\Application\PrivateBackupRestoreService.cs</Link>
    </Compile>
    <Compile Include="..\..\Application\PrivateBackupService.cs">
      <Link>host\DataManagement\Application\PrivateBackupService.cs</Link>
    </Compile>
    <Compile Include="..\..\Application\UserDataDeletionService.cs">
      <Link>host\DataManagement\Application\UserDataDeletionService.cs</Link>
    </Compile>
    <Compile Include="..\..\Application\UserDataExportService.cs">
      <Link>host\DataManagement\Application\UserDataExportService.cs</Link>
    </Compile>
    <Compile Include="..\..\Contracts\BackupRestoreResult.cs">
      <Link>host\DataManagement\Contracts\BackupRestoreResult.cs</Link>
    </Compile>
    <Compile Include="..\..\Contracts\IAppMaintenanceCoordinator.cs">
      <Link>host\DataManagement\Contracts\IAppMaintenanceCoordinator.cs</Link>
    </Compile>
    <Page Include="..\..\Desktop\PrivacyPage.xaml">
      <Link>Settings\PrivacyPage.xaml</Link>
    </Page>
    <Compile Include="..\..\Desktop\PrivacyPage.xaml.cs">
      <Link>host\DataManagement\Desktop\PrivacyPage.xaml.cs</Link>
    </Compile>
  </ItemGroup>
</Project>
