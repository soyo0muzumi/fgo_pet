<Project Sdk="Microsoft.NET.Sdk">

  <!-- 阶段 1 项目拆分：条目由 src/FgoPet.App 迁出。 -->
  <!-- Include 相对本 csproj；Link 逐字沿用（决定 WPF 资源 URI 与生成类命名空间）。 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <UseWPF>false</UseWPF>
    <RootNamespace>FgoPet.App</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FgoPet.App.Tests" />
    <InternalsVisibleTo Include="FgoPet.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Contracts\AgentTodoDataClearContract.cs">
      <Link>host\DesktopShell\Contracts\AgentTodoDataClearContract.cs</Link>
    </Compile>
    <Compile Include="..\..\Contracts\ISettingsNavigator.cs">
      <Link>host\DesktopShell\Contracts\ISettingsNavigator.cs</Link>
    </Compile>
    <Compile Include="..\..\Contracts\PackageDetailRoute.cs">
      <Link>host\DesktopShell\Contracts\PackageDetailRoute.cs</Link>
    </Compile>
    <Compile Include="..\..\Contracts\Phase2RuntimeContracts.cs">
      <Link>host\DesktopShell\Contracts\Phase2RuntimeContracts.cs</Link>
    </Compile>
    <Compile Include="..\..\Contracts\SettingsSection.cs">
      <Link>host\DesktopShell\Contracts\SettingsSection.cs</Link>
    </Compile>
    <Compile Include="..\..\Contracts\UserDataPrivacyContracts.cs">
      <Link>host\DesktopShell\Contracts\UserDataPrivacyContracts.cs</Link>
    </Compile>
  </ItemGroup>
</Project>
