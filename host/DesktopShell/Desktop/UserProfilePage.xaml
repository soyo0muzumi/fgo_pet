<UserControl x:Class="FgoPet.App.Settings.UserProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Focusable="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsControls.xaml" />
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,4,14,18">
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="基础资料" />
                    <TextBlock Margin="0,0,0,10"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="显示名称" />
                    <TextBox x:Name="DisplayNameBox"
                             Style="{StaticResource SettingsTextBoxStyle}"
                             MaxLength="80"
                             ToolTip="可选。仅用于应用内的全局用户资料。"
                             automation:AutomationProperties.Name="用户显示名称"
                             Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource SettingsStatusStyle}"
                               Text="{Binding ProfileOnlyExplanation}" />
                    <StackPanel Margin="0,16,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="ResetButton"
                                Margin="0,0,8,0"
                                Padding="14,8"
                                Style="{StaticResource SettingsSecondaryButtonStyle}"
                                Command="{Binding ResetCommand}"
                                Content="恢复默认"
                                ToolTip="清除全局显示名称"
                                automation:AutomationProperties.Name="恢复默认用户资料" />
                        <Button x:Name="SaveButton"
                                Padding="14,8"
                                Style="{StaticResource SettingsPrimaryButtonStyle}"
                                Command="{Binding SaveCommand}"
                                Content="保存"
                                IsDefault="True"
                                automation:AutomationProperties.Name="保存用户资料" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="资料边界" />
                    <TextBlock Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap"
                               Text="角色称呼由每个角色包的称呼设置独立保存，并按稳定的 servant_id 区分。修改这里的显示名称不会改变任何角色称呼。" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SettingsStatusStyle}"
                       Text="{Binding StatusText}"
                       automation:AutomationProperties.LiveSetting="Polite" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource SettingsStatusStyle}"
                       Foreground="{DynamicResource DangerBrush}"
                       Text="{Binding ErrorText}"
                       TextWrapping="Wrap"
                       automation:AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
