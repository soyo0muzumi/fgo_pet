<Window x:Class="FgoPet.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FgoPet.App.Settings.Views"
        Title="FGO Pet · 设置"
        Width="820" Height="640" MinWidth="680" MinHeight="520" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellWindowBackgroundBrush}"
        Foreground="{DynamicResource ShellTextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/FgoPet.App;component/Ui/Shell/ChatControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <views:SettingsShellView x:Name="SettingsShell" />
</Window>
