<UserControl x:Class="FgoPet.App.Views.AgentDispatchDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI"
             KeyboardNavigation.TabNavigation="Cycle"
             Focusable="True">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <SolidColorBrush x:Key="Cyan" Color="#FF70E7F5"/>
    <SolidColorBrush x:Key="Text" Color="#FFF0F5FF"/>
    <SolidColorBrush x:Key="Muted" Color="#FF9FB2D8"/>
    <SolidColorBrush x:Key="Error" Color="#FFFF9EBE"/>
    <Style x:Key="DialogButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Background" Value="#33101C2E"/>
      <Setter Property="BorderBrush" Value="#6638516C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="MinWidth" Value="76"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
      <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
      <Setter Property="Background" Value="#2642DFF5"/>
      <Setter Property="BorderBrush" Value="#CC42DFF5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Resources>
  <Border Background="#F217243B" BorderBrush="#FF42DFF5" BorderThickness="1" Padding="16">
    <StackPanel MinWidth="390" MaxWidth="520">
      <TextBlock Text="交给 Agent" Foreground="{StaticResource Cyan}" FontSize="14" FontWeight="Bold"/>
      <TextBlock Text="确认后才会发送这个 Todo。来源与目标取自当前 Relay 授权快照。"
                 Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,12"/>

      <TextBlock Text="待派发 Todo" Foreground="{StaticResource Muted}" FontSize="9"/>
      <Border Background="#33101C2E" BorderBrush="#6638516C" BorderThickness="1" Padding="8" Margin="0,3,0,10">
        <StackPanel>
          <TextBlock Text="{Binding Todo.Title}" Foreground="{StaticResource Text}" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Todo.Description}" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>

      <TextBlock Text="来源（已启用且在线）" Foreground="{StaticResource Muted}" FontSize="9"/>
      <ComboBox x:Name="SourceCombo"
                ItemsSource="{Binding Sources}"
                SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                IsEnabled="{Binding CanSelect}"
                Margin="0,3,0,9"
                AutomationProperties.Name="来源（已启用且在线）">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Text}"/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="9">
                <Run Text="{Binding SourceType}"/><Run Text=" · 实例 "/><Run Text="{Binding SourceInstanceId}"/>
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Text="目标 ID（适配器提供的不透明标识）" Foreground="{StaticResource Muted}" FontSize="9"/>
      <ComboBox ItemsSource="{Binding Targets}"
                SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                IsEnabled="{Binding CanSelect}"
                Margin="0,3,0,3"
                AutomationProperties.Name="目标 ID（适配器提供的不透明标识）"/>
      <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
      <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Error}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"
                 AutomationProperties.LiveSetting="Assertive"/>
      <ProgressBar Height="3" Margin="0,8,0,0" IsIndeterminate="True"
                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button x:Name="CancelButton" Content="取消" Style="{StaticResource DialogButton}" Click="OnCancelClick" AutomationProperties.Name="取消派发"/>
        <Button Content="确认派发" Style="{StaticResource PrimaryDialogButton}" Command="{Binding ConfirmCommand}"
                Margin="8,0,0,0" AutomationProperties.Name="确认派发"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
