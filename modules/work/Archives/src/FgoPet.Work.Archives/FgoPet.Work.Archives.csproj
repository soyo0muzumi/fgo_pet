<Project Sdk="Microsoft.NET.Sdk">

  <!-- 阶段 1 项目拆分：条目由 src/FgoPet.App 迁出。 -->
  <!-- Include 相对本 csproj；Link 逐字沿用（决定 WPF 资源 URI 与生成类命名空间）。 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FgoPet.App</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FgoPet.App.Tests" />
    <InternalsVisibleTo Include="FgoPet.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../../src/FgoPet.Core/FgoPet.Core.csproj" />
    <ProjectReference Include="../../../../../src/FgoPet.Infrastructure/FgoPet.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Application\AgentArchiveService.cs">
      <Link>modules\work\Archives\Application\AgentArchiveService.cs</Link>
    </Compile>
    <Compile Include="..\..\Application\ArchiveDraftService.cs">
      <Link>modules\work\Archives\Application\ArchiveDraftService.cs</Link>
    </Compile>
    <Compile Include="..\..\Application\LongArchiveService.cs">
      <Link>modules\work\Archives\Application\LongArchiveService.cs</Link>
    </Compile>
    <Page Include="..\..\Desktop\ArchiveDraftCard.xaml">
      <Link>Views\ArchiveDraftCard.xaml</Link>
    </Page>
    <Compile Include="..\..\Desktop\ArchiveDraftCard.xaml.cs">
      <Link>modules\work\Archives\Desktop\ArchiveDraftCard.xaml.cs</Link>
    </Compile>
    <Compile Include="..\..\Desktop\ArchiveDraftViewModel.cs">
      <Link>modules\work\Archives\Desktop\ArchiveDraftViewModel.cs</Link>
    </Compile>
  </ItemGroup>
</Project>
