<UserControl x:Class="FgoPet.App.Settings.PersonalizationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Focusable="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsControls.xaml" />
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border>
        <StackPanel Margin="4,4,14,18">
            <TextBlock Text="主题" Foreground="{DynamicResource Text.Secondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
            <ContentControl x:Name="ThemeHost" HorizontalContentAlignment="Stretch"/>
            <Border Background="{DynamicResource Surface.Content}" BorderBrush="{DynamicResource Border.Decorative}"
                    Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="82" Height="108" Background="{DynamicResource Surface.Subtle}" BorderBrush="{DynamicResource Border.Decorative}"
                            BorderThickness="1" CornerRadius="10" HorizontalAlignment="Left">
                        <Grid>
                            <Image Source="{Binding Library.SelectedServant.PreviewSource}" Stretch="Uniform" />
                            <TextBlock Text="未提供预览" Foreground="{DynamicResource Text.Secondary}" FontSize="10"
                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Library.SelectedServant.PreviewSource}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Library.SelectedServant.PreviewSource}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,4,12,4" VerticalAlignment="Center">
                        <TextBlock Text="当前角色" Foreground="{DynamicResource Text.Primary}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Library.SelectedServant.DisplayName, TargetNullValue=尚未选择角色}" Foreground="{DynamicResource Text.Primary}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="当前使用的角色与立绘外观" Style="{StaticResource SettingsStatusStyle}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="更换角色" Style="{StaticResource SettingsSecondaryButtonStyle}" Click="OnChangeServantClick" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Background="{DynamicResource Surface.Content}" BorderBrush="{DynamicResource Border.Decorative}"
                    Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="桌宠显示" />
                    <TextBlock Margin="0,0,0,10"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="桌宠缩放" />
                    <ComboBox x:Name="ScaleComboBox"
                              Width="180"
                              HorizontalAlignment="Left"
                              Style="{StaticResource SettingsComboBoxStyle}"
                              ItemsSource="{Binding ViewModel.ScaleOptions}"
                              ItemStringFormat="{}{0:P0}"
                              SelectedItem="{Binding ViewModel.Scale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="仅支持 50%、60% 和 75%"
                              automation:AutomationProperties.Name="桌宠缩放比例" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource SettingsStatusStyle}"
                               Text="支持的缩放值与现有画像渲染管线保持一致。" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource Surface.Content}" BorderBrush="{DynamicResource Border.Decorative}"
                    Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="窗口行为" />
                    <CheckBox x:Name="TopmostCheckBox"
                              Margin="0,2,0,12"
                              Foreground="{DynamicResource TextBrush}"
                              Content="桌宠窗口始终置顶"
                              IsChecked="{Binding ViewModel.Topmost, Mode=TwoWay}"
                              ToolTip="在其他窗口前显示桌宠"
                              automation:AutomationProperties.Name="桌宠窗口始终置顶" />
                    <CheckBox x:Name="AutoCollapseCheckBox"
                              Foreground="{DynamicResource TextBrush}"
                              Content="展开面板无操作时自动收起"
                              IsChecked="{Binding ViewModel.AutoCollapseExpandedPanel, Mode=TwoWay}"
                              ToolTip="沿用运行时面板的自动收起行为"
                              automation:AutomationProperties.Name="展开面板无操作时自动收起" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource Surface.Content}" BorderBrush="{DynamicResource Border.Decorative}"
                    Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="恢复设置" />
                    <TextBlock Style="{StaticResource SettingsStatusStyle}"
                               Margin="0,0,0,12"
                               Text="恢复会将缩放设为 50%，开启置顶和自动收起。主题选择不会被这里改动。" />
                    <Button x:Name="ResetButton"
                            Width="140"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SettingsSecondaryButtonStyle}"
                            Command="{Binding ViewModel.ResetCommand}"
                            Content="恢复默认"
                            automation:AutomationProperties.Name="恢复默认个性化设置" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SettingsStatusStyle}"
                       Text="{Binding ViewModel.StatusText}"
                       automation:AutomationProperties.LiveSetting="Polite" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource SettingsStatusStyle}"
                       Foreground="{DynamicResource DangerBrush}"
                       Text="{Binding ViewModel.ErrorText}"
                       TextWrapping="Wrap"
                       automation:AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
    </Border>
</UserControl>
