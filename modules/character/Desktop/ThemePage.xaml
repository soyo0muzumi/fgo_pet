<UserControl x:Class="FgoPet.App.Settings.ThemePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Focusable="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsControls.xaml" />
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border>
        <StackPanel Margin="4,4,14,18">
            <TextBlock Margin="0,0,0,14"
                       Style="{StaticResource SettingsStatusStyle}"
                       Text="选择浅色或深色，立即应用并保存。首次启动默认浅色；已有主题选择会保留。" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="ModernGrayChoice"
                             Grid.Column="0"
                             MinHeight="190"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch"
                             Style="{StaticResource SettingsThemeChoiceStyle}"
                             IsChecked="{Binding IsModernGraySelected, Mode=OneWay}"
                             Checked="ThemeChoice_Checked"
                             ToolTip="选择 Modern Gray"
                             automation:AutomationProperties.Name="Modern Gray 主题"
                             automation:AutomationProperties.HelpText="深灰色表面与柔和的紫色强调色">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#FF18191F"
                                CornerRadius="5"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#FF23242B"
                                        CornerRadius="3"
                                        Margin="0,0,8,0" />
                                <Border Grid.Column="1"
                                        Background="#FFC3A8FF"
                                        CornerRadius="3" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,4"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="深色" />
                        <TextBlock Grid.Row="2"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="深灰色表面与柔和的紫色强调色，让文字和操作清晰可见。" />
                    </Grid>
                </RadioButton>

                <RadioButton x:Name="FgoLightChoice"
                             Grid.Column="1"
                             MinHeight="190"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch"
                             Style="{StaticResource SettingsThemeChoiceStyle}"
                             IsChecked="{Binding IsFgoLightSelected, Mode=OneWay}"
                             Checked="ThemeChoice_Checked"
                             ToolTip="选择 FGO Light"
                             automation:AutomationProperties.Name="FGO Light 主题"
                             automation:AutomationProperties.HelpText="浅灰色底面、白色阅读区与紫色强调色">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#FFF1F0F3"
                                CornerRadius="5"
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#FFFFFFFF"
                                        CornerRadius="3"
                                        Margin="0,0,8,0" />
                                <Border Grid.Column="1"
                                        Background="#FF7050B8"
                                        CornerRadius="3" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,4"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="浅色" />
                        <TextBlock Grid.Row="2"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="浅灰色底面与白色阅读区，紫色用于选中状态和主要操作。" />
                    </Grid>
                </RadioButton>
            </Grid>

            <TextBlock x:Name="StatusTextBlock"
                       Margin="0,16,0,0"
                       Style="{StaticResource SettingsStatusStyle}"
                       Text="{Binding StatusText}"
                       automation:AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Border>
</UserControl>
