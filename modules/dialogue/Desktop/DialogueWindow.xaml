<Window x:Class="FgoPet.App.Dialogue.DialogueWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FgoPet.App.Views;assembly=FgoPet.Work.Todo"
 Title="FGO Pet · 聊天" Width="720" Height="640" MinWidth="500" MinHeight="540" WindowStartupLocation="Manual" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Background="{DynamicResource ShellWindowBackgroundBrush}" Foreground="{DynamicResource ShellTextBrush}" UseLayoutRounding="True">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/FgoPet.App;component/Ui/Shell/ChatControls.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Bool"/><StreamGeometry x:Key="HistoryDeleteIcon">M2,4 H14 M6,4 V2 H10 V4 M4,4 L5,14 H11 L12,4 M7,6 V12 M9,6 V12</StreamGeometry></ResourceDictionary></Window.Resources>
<Grid x:Name="ShellRoot" Background="{DynamicResource Surface.Content}">
<Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="90"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.RowSpan="2" Background="{DynamicResource Surface.App}" BorderBrush="{DynamicResource Border.Decorative}" BorderThickness="0,0,1,0">
<DockPanel Margin="4,16,4,12" LastChildFill="True">
<Button x:Name="SettingsButton" DockPanel.Dock="Bottom" Content="设置" Tag="{StaticResource ChatSettings}" Style="{StaticResource ShellRailButton}" Click="OnSettingsClick" ToolTip="设置" AutomationProperties.Name="设置" Margin="0"/>
<StackPanel><TextBlock Text="FGO" FontSize="11" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,6,0,24"/>
<Button x:Name="ChatTabButton" Content="聊天" Tag="{StaticResource ChatBubble}" Click="OnChatClick" Style="{StaticResource ShellRailSelectedButton}" ToolTip="聊天" AutomationProperties.Name="聊天"/>
<Button x:Name="TasksButton" Content="待办" Tag="{StaticResource ChatTasks}" Click="OnTasksClick" Style="{StaticResource ShellRailButton}" ToolTip="待办" AutomationProperties.Name="待办"/>
<Button x:Name="FocusNavigationButton" Content="专注" Tag="{StaticResource ChatFocus}" Click="OnFocusShortcutClick" Style="{StaticResource ShellRailButton}" ToolTip="开始专注" AutomationProperties.Name="专注"/>
</StackPanel></DockPanel></Border>
<Border Grid.Column="1" BorderBrush="{DynamicResource Border.Decorative}" BorderThickness="0,0,0,1">
<Grid x:Name="IdentityHeader" Margin="24,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Border x:Name="RoleAvatar" Width="54" Height="54" Background="{DynamicResource Surface.Subtle}" CornerRadius="14" VerticalAlignment="Center"><Grid>
<Path Data="{StaticResource ChatPerson}" Width="24" Height="26" Stretch="Uniform" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="1.2"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=RoleImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
<Image x:Name="RoleImage" Source="{Binding SelectedServant.PreviewSource}" Stretch="Uniform" Margin="3" ImageFailed="OnAvatarFailed" AutomationProperties.Name="当前角色头像"/>
</Grid></Border>
<StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="{Binding ActiveServantDisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="HeaderSubtitle" Text="今天，也按自己的节奏来。" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
<Button x:Name="HistoryButton" Style="{StaticResource ChatMessageAction}" Content="{StaticResource ChatHistory}" Click="OnHistoryClick" ToolTip="历史对话" AutomationProperties.Name="历史对话"/>
<Button x:Name="NewConversationButton" Content="{StaticResource ChatNew}" Style="{StaticResource ChatMessageAction}" Click="OnNewClick" ToolTip="新对话" AutomationProperties.Name="新对话" Margin="4,0"/>
<Button Style="{StaticResource ChatMessageAction}" Content="{StaticResource ChatHide}" ToolTip="收起窗口，桌宠继续显示" AutomationProperties.Name="收起窗口" Click="OnHideClick"/>
</StackPanel></Grid></Border>
<Grid Grid.Column="1" Grid.Row="1" x:Name="ChatBody" Margin="24,16,24,18"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Button x:Name="ProjectButton" Grid.Row="2" HorizontalAlignment="Left" MaxWidth="260" Margin="0,6,0,0" Click="OnProjectClick" ToolTip="选择对话项目；切换项目会开始新对话" AutomationProperties.Name="选择对话项目"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChatTextButton}"><Style.Triggers><DataTrigger Binding="{Binding Conversation.IsStreaming}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style><TextBlock Text="{Binding Conversation.SessionContext.ProjectSelectionText}" TextTrimming="CharacterEllipsis"/></Button>
<Grid>
<ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel x:Name="ReadingColumn" MaxWidth="680" Margin="0,8,0,16">
<StackPanel x:Name="Welcome" Margin="18,32,18,24" HorizontalAlignment="Center"><TextBlock Text="今天也按自己的节奏来。" FontSize="23" FontWeight="Medium" Foreground="{DynamicResource Text.Primary}" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="WelcomeSecondaryCopy" Text="想说点什么就告诉我。" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="410" Margin="0,10,0,0"/><StackPanel x:Name="WelcomeShortcuts" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"><Button x:Name="FocusShortcutButton" Content="开始专注" Style="{StaticResource ChatTextButton}" Click="OnFocusShortcutClick" AutomationProperties.Name="开始专注" Margin="0,0,8,0"/><Button x:Name="TodoShortcutButton" Content="查看待办" Style="{StaticResource ChatTextButton}" Click="OnTasksClick" AutomationProperties.Name="查看待办"/></StackPanel></StackPanel>
<TextBlock Text="正在回复…" Margin="0,0,0,8" Foreground="{DynamicResource ShellAccentBrush}" Visibility="{Binding Conversation.IsStreaming, Converter={StaticResource Bool}}"/><ItemsControl ItemsSource="{Binding Conversation.Turns}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Margin" Value="0,0,0,22"/><Style.Triggers><DataTrigger Binding="{Binding HasVisibleText}" Value="False"><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
<Border x:Name="AssistantLabel" BorderBrush="{DynamicResource ShellAccentBrush}" BorderThickness="3,0,0,0" Padding="9,0,0,0" Margin="0,2,0,12"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsAssistant}" Value="True"/><Condition Binding="{Binding HasVisibleText}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding DataContext.ActiveServantDisplayName, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{DynamicResource ShellAccentBrush}" TextTrimming="CharacterEllipsis"/></Border>
<Border x:Name="MessageBody" CornerRadius="14,14,3,14"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="14,10"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="{DynamicResource ShellPanelBackgroundBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsAssistant}" Value="True"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/></DataTrigger><DataTrigger Binding="{Binding HasVisibleText}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ShellTextBrush}" FontSize="15" TextBlock.LineHeight="26" Padding="0" Style="{StaticResource ChatInput}"/></Border>
<Border x:Name="ReasoningWell" Margin="0,6,0,0" Padding="10,6" CornerRadius="10" Background="{DynamicResource ShellPanelBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasVisibleReasoning}" Value="True"/><Condition Binding="{Binding DataContext.Conversation.ShowReasoning, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
<ToggleButton x:Name="ReasoningToggle" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" IsChecked="{Binding IsReasoningExpanded, Mode=TwoWay}" AutomationProperties.Name="思考过程"><TextBlock Text="思考" Foreground="{DynamicResource ShellMutedTextBrush}" FontSize="12"/></ToggleButton>
<TextBlock Text="{Binding ReasoningText}" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedTextBrush}" FontSize="12" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsReasoningExpanded}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
</StackPanel></Border>
<StackPanel x:Name="MessageActions" Orientation="Horizontal" Margin="0,4,0,0">
<StackPanel.Style><Style TargetType="StackPanel"><Setter Property="HorizontalAlignment" Value="Right"/><Style.Triggers><DataTrigger Binding="{Binding IsAssistant}" Value="True"><Setter Property="HorizontalAlignment" Value="Left"/></DataTrigger><DataTrigger Binding="{Binding HasVisibleText}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
<Button IsEnabled="{Binding Actions.CanCopy}" Content="{StaticResource ChatCopy}" Tag="{Binding}" Click="OnCopyClick" Style="{StaticResource ChatMessageAction}" ToolTip="复制" AutomationProperties.Name="复制" Margin="0,0,4,0"/>
<Button Tag="{Binding}" Click="OnSpeechClick" ToolTip="{Binding SpeechActionText}" AutomationProperties.Name="{Binding SpeechActionText}" Visibility="{Binding CanReadAloud, Converter={StaticResource Bool}}">
<Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChatMessageAction}"><Setter Property="Content" Value="{StaticResource ChatSpeak}"/><Style.Triggers><DataTrigger Binding="{Binding SpeechActionText}" Value="停止朗读"><Setter Property="Content" Value="{StaticResource ChatStop}"/><Setter Property="Foreground" Value="{DynamicResource ShellAccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
</Button>
<Button Tag="{Binding}" Click="OnViewTodoClick" Content="{StaticResource ChatTasks}" ContentTemplate="{StaticResource ChatIcon}" Style="{StaticResource ChatMessageAction}" ToolTip="查看待办" AutomationProperties.Name="查看待办" Visibility="{Binding CanViewTodo, Converter={StaticResource Bool}}" Margin="8,0,0,0"/>
</StackPanel>
</StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<ItemsControl ItemsSource="{Binding Conversation.TodoProposals}"><ItemsControl.ItemTemplate><DataTemplate><views:TodoProposalCard/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<ItemsControl ItemsSource="{Binding Conversation.RecalledSources}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4,0,8"><Button Content="{Binding Title}" Command="{Binding OpenCommand}" Style="{StaticResource ChatTextButton}" HorizontalAlignment="Left" ToolTip="打开历史来源"/><TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" MaxHeight="36" Foreground="{DynamicResource ShellMutedTextBrush}" FontSize="12"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="{Binding Conversation.RequestStatusText}" Foreground="{DynamicResource ShellMutedTextBrush}" TextWrapping="Wrap" FontSize="12"/>
<Border x:Name="FailureNotice" BorderBrush="{DynamicResource State.Danger}" BorderThickness="3,0,0,0" Padding="12,8" Margin="0,8" Visibility="Collapsed"><StackPanel><TextBlock Text="{Binding Conversation.ErrorText}" Foreground="{DynamicResource State.Danger}" TextWrapping="Wrap"/><TextBlock Text="输入内容已保留，可以检查后重新发送。" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,6"/><Button Content="重新发送输入内容" Command="{Binding Conversation.SendCommand}" Style="{StaticResource ChatTextButton}" HorizontalAlignment="Left"/></StackPanel></Border><TextBlock x:Name="StoppedNotice" Text="已停止生成" FontSize="12" Foreground="{DynamicResource Text.Secondary}" Visibility="Collapsed" Margin="0,8"/>
<Button Content="配置聊天模型" Command="{Binding Conversation.OpenSettingsCommand}" Style="{StaticResource ChatTextButton}" HorizontalAlignment="Left" Visibility="{Binding Conversation.IsConfigurationStateVisible, Converter={StaticResource Bool}}"/>
</StackPanel></ScrollViewer>
<Button x:Name="JumpButton" Content="回到底部" Style="{StaticResource ChatTextButton}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Click="OnJumpClick" Visibility="Collapsed"/>
</Grid>
<Border x:Name="ComposerBorder" Grid.Row="1" MinHeight="76" CornerRadius="16" Background="{DynamicResource Surface.Subtle}" Padding="12,8" Margin="0,12,0,0"><Border.Style><Style TargetType="Border"><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource Border.Decorative}"/><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=InputBox}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Focus.Ring}"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><TextBox x:Name="InputBox" Style="{StaticResource ChatInput}" MinHeight="32" MaxHeight="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding Composer.InputText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="聊天输入"/><TextBlock IsHitTestVisible="False" Text="说些什么……" Margin="6" Foreground="{DynamicResource ShellMutedTextBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Composer.InputText}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=InputBox}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
<DockPanel Grid.Row="1" Margin="0,6,0,0"><Button x:Name="SendButton" DockPanel.Dock="Right" Command="{Binding Composer.SendOrStopCommand}" ContentTemplate="{StaticResource ChatIcon}" ToolTip="{Binding Composer.ActionLabel}" AutomationProperties.Name="{Binding Composer.ActionLabel}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChatButton}"><Setter Property="Content" Value="{StaticResource ChatSend}"/><Setter Property="Background" Value="{DynamicResource Action.Primary}"/><Setter Property="Foreground" Value="{DynamicResource Action.OnPrimary}"/><Style.Triggers><DataTrigger Binding="{Binding Conversation.IsStreaming}" Value="True"><Setter Property="Content" Value="{StaticResource ChatStop}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="Enter 发送 · Shift + Enter 换行" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/></DockPanel>
</Grid></Border>
</Grid>
<Button x:Name="Backdrop" Grid.Column="1" Grid.Row="1" Background="{DynamicResource ShellOverlayBrush}" Visibility="Collapsed" Click="OnCloseClick" AutomationProperties.Name="返回聊天"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Button.Template></Button>
<Border x:Name="HistoryDrawer" Grid.Column="1" Grid.Row="1" Width="276" HorizontalAlignment="Left" Background="{DynamicResource Surface.Content}" BorderBrush="{DynamicResource Border.Decorative}" BorderThickness="0,0,1,0" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
<Grid Margin="14">
 <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource ChatButton}" Content="{StaticResource ChatClose}" ContentTemplate="{StaticResource ChatIcon}" Click="OnCloseClick" ToolTip="返回聊天"/><TextBlock Text="历史对话" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
 <Grid Grid.Row="1" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Button Content="新对话" Style="{StaticResource ChatTextButton}" Click="OnNewClick"/>
  <Button Grid.Column="1" Content="刷新" Style="{StaticResource ChatTextButton}" Margin="8,0,0,0" Click="OnHistoryRefreshClick" ToolTip="刷新历史对话"/>
  <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="仅当前项目（未选时为无项目）" IsChecked="{Binding Conversation.FilterHistoryByProject}" Margin="0,8,0,0" FontSize="12"/>
 </Grid>
 <ListBox x:Name="HistoryList" Grid.Row="2" ItemsSource="{Binding Conversation.History}" ItemContainerStyle="{StaticResource ChatHistoryItem}" BorderThickness="0" Background="Transparent" KeyDown="OnHistoryKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="历史对话">
  <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
   <Button x:Name="HistoryOpenButton" Click="OnHistoryOpenClick" Tag="{Binding}" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text.Primary}" HorizontalContentAlignment="Stretch" ToolTip="查看并继续这段对话" AutomationProperties.Name="{Binding Title}">
    <Button.Template><ControlTemplate TargetType="Button"><Grid><Border x:Name="RowChrome" Padding="4,8" Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Stretch"/></Border><Border x:Name="RowFocus" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Focus.Ring}" Visibility="Collapsed" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource Surface.Hover}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowFocus" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
    <StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UpdatedText}" FontSize="12" Foreground="{DynamicResource ShellTextBrush}"/></StackPanel>
   </Button>
   <Button x:Name="HistoryDeleteButton" Grid.Column="1" Style="{StaticResource ChatMessageAction}" Content="{StaticResource HistoryDeleteIcon}" Click="OnHistoryDeleteClick" Tag="{Binding}" ToolTip="删除这段对话" AutomationProperties.Name="删除这段对话" IsEnabled="{Binding DataContext.Conversation.CanDeleteHistory, RelativeSource={RelativeSource AncestorType=Window}}"/>
  </Grid></DataTemplate></ListBox.ItemTemplate>
 </ListBox>
 <StackPanel Grid.Row="3">
  <Button Content="加载更多" Style="{StaticResource ChatTextButton}" Command="{Binding Conversation.LoadMoreHistoryCommand}" Visibility="{Binding Conversation.HasMoreHistory, Converter={StaticResource Bool}}" Margin="0,6,0,0"/>
  <TextBlock x:Name="HistoryStatusText" Text="{Binding Conversation.HistoryStatus}" Foreground="{DynamicResource Text.Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
 <Border x:Name="HistoryDeleteConfirmation" Grid.Row="4" Margin="0,10,0,0" Padding="10" CornerRadius="8" Background="{DynamicResource Surface.Subtle}" BorderBrush="{DynamicResource Border.Decorative}" BorderThickness="1" Visibility="{Binding Conversation.HasPendingHistoryDeletion, Converter={StaticResource Bool}}">
  <StackPanel>
   <TextBlock Text="删除这段对话？" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding Conversation.PendingHistoryDeletion.Title}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
   <TextBlock Text="将移除消息、摘要和未审核的记忆候选。已确认记忆会保留。此操作无法撤销。" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,6,0,10"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="CancelHistoryDeleteButton" Content="取消" Style="{StaticResource ChatTextButton}" Click="OnCancelHistoryDeleteClick"/>
    <Button x:Name="ConfirmHistoryDeleteButton" Content="确认删除" Style="{StaticResource ChatTextButton}" Foreground="{DynamicResource DangerBrush}" Margin="8,0,0,0" Click="OnConfirmHistoryDeleteClick" IsEnabled="{Binding Conversation.CanDeleteHistory}"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Grid>
</Border>
<ContentControl x:Name="TasksPage" Grid.Column="1" Grid.Row="1" Background="{DynamicResource Surface.App}" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
</Grid></Window>
