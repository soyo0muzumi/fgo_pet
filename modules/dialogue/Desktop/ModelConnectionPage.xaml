<UserControl x:Class="FgoPet.App.Settings.ModelConnectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsControls.xaml" />
                <ResourceDictionary Source="/FgoPet.App;component/Themes/SettingsIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ConnectionSection" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Margin" Value="0,0,0,24"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="ConnectionScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
                <Border Style="{StaticResource ConnectionSection}">
                    <StackPanel>
                        <TextBlock Text="聊天模型" FontSize="18" Style="{StaticResource SettingsPageHeaderStyle}"/>
                        <TextBlock Text="连接你习惯使用的模型服务。" Style="{StaticResource SettingsStatusStyle}" Margin="0,6,0,12"/>
                        <Grid x:Name="ConnectionFields">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel x:Name="ProviderField" Margin="0,0,16,0"><TextBlock Margin="0,12,0,0" Text="模型供应商" Style="{StaticResource SettingsCaptionStyle}" />
                <ComboBox x:Name="ProviderComboBox"
                          Style="{StaticResource SettingsComboBoxStyle}"
                          ItemsSource="{Binding Providers}"
                          SelectedValuePath="ProviderId"
                          SelectedValue="{Binding SelectedProviderId, UpdateSourceTrigger=PropertyChanged}"
                          automation:AutomationProperties.Name="模型供应商">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox></StackPanel>
                            <StackPanel x:Name="ModelField" Grid.Column="1"><TextBlock Margin="0,12,0,0" Text="默认模型 ID" Style="{StaticResource SettingsCaptionStyle}" />
                <Grid>
                    <TextBox x:Name="ModelTextBox"
                             Style="{StaticResource SettingsTextBoxStyle}"
                             Padding="9,7,38,7"
                             Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}"
                             automation:AutomationProperties.Name="模型 ID" />
                    <ToggleButton x:Name="ModelPickerToggle"
                                  HorizontalAlignment="Right"
                                  Width="34"
                                  Height="34"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsChecked="{Binding IsModelPickerOpen, Mode=TwoWay}"
                                  ToolTip="选择可用模型"
                                  automation:AutomationProperties.Name="展开模型列表">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}">
                                    <Path Width="9" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="{DynamicResource MutedTextBrush}" Data="M 0,0 L 9,0 L 4.5,6 Z" />
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>

                <Popup x:Name="ModelPickerPopup"
                       PlacementTarget="{Binding ElementName=ModelPickerToggle}"
                       Placement="Bottom"
                       VerticalOffset="6"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       IsOpen="{Binding IsModelPickerOpen, Mode=TwoWay}"
                       DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <Border Width="250"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="可用模型" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="RefreshModelsButton"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                                        Content="刷新"
                                        Padding="9,5"
                                        Command="{Binding RefreshModelsCommand}" />
                            </Grid>
                            <Grid MinHeight="80">
                                <ListBox x:Name="ModelList"
                                         MinHeight="80" MaxHeight="180"
                                         Style="{StaticResource SettingsListBoxStyle}"
                                         ItemsSource="{Binding AvailableModels}"
                                         DisplayMemberPath="DisplayName"
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding ModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         SelectionChanged="OnModelSelectionChanged"
                                         automation:AutomationProperties.Name="可用模型列表" />
                                <StackPanel x:Name="ModelListEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="尚未获取模型" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="使用“刷新”获取供应商模型。" Style="{StaticResource SettingsStatusStyle}" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=ModelList, Path=HasItems}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border></Popup></StackPanel>
                        </Grid>
                        <TextBlock Margin="0,14,0,0" Text="Base URL" Style="{StaticResource SettingsCaptionStyle}" />
                <TextBox x:Name="BaseUrlBox"
                         Style="{StaticResource SettingsTextBoxStyle}"
                         Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                         automation:AutomationProperties.Name="Base URL" />
                        <TextBlock Margin="0,14,0,0" Text="API Key" Style="{StaticResource SettingsCaptionStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiKeyBox"
                                 Style="{StaticResource SettingsPasswordBoxStyle}"
                                 ToolTip="密钥只保存到 Windows Credential Manager，不会写入设置文件。"
                                 automation:AutomationProperties.Name="API Key" />
                    <Button Grid.Column="1" Margin="8,0,0,0"
                            x:Name="ClearKeyButton"
                            Style="{StaticResource SettingsSecondaryButtonStyle}"
                            Content="清除已保存密钥"
                            Command="{Binding ClearKeyCommand}" />
                </Grid>
                <TextBlock Margin="0,5,0,0" Style="{StaticResource SettingsStatusStyle}"
                           Text="{Binding KeyStateText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ConnectionSection}">
            <StackPanel>
                <TextBlock Text="上下文与输出" Style="{StaticResource SettingsPageHeaderStyle}" />
                <TextBlock Text="上下文上限（tokens，可留空使用模型资料）" Style="{StaticResource SettingsCaptionStyle}" Margin="0,12,0,0" />
                <TextBox Text="{Binding ContextWindowOverrideText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}"
                         automation:AutomationProperties.Name="上下文上限覆盖" />
                <TextBlock Text="最大输出（tokens）" Style="{StaticResource SettingsCaptionStyle}" Margin="0,12,0,0" />
                <TextBox Text="{Binding MaxOutputTokensText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}"
                         automation:AutomationProperties.Name="最大输出" />
                <TextBlock Text="{Binding ContextLimitText}" Style="{StaticResource SettingsStatusStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
                <Border Style="{StaticResource ConnectionSection}">
            <StackPanel>
                <TextBlock Text="回复显示" Style="{StaticResource SettingsPageHeaderStyle}" />
                <CheckBox x:Name="ShowReasoningCheck"
                          Content="显示模型思考过程"
                          IsChecked="{Binding ShowReasoning, Mode=TwoWay}"
                          automation:AutomationProperties.Name="显示模型思考过程" />
                <TextBlock Margin="0,5,0,0" Style="{StaticResource SettingsStatusStyle}"
                           Text="对话窗口在生成回复时展示模型的思考流。关闭后仅显示生成状态；不影响对话内容本身。" />
            </StackPanel>
        </Border>
                <TextBlock Text="未连接模型时，桌宠与本地专注仍可离线使用。" Style="{StaticResource SettingsStatusStyle}" Margin="0,0,0,16"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource Border.Decorative}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <StackPanel>
                <WrapPanel>
                    <Button x:Name="TestConnectionButton"
                            Style="{StaticResource SettingsSecondaryButtonStyle}"
                            Content="测试连接"
                            Command="{Binding TestCommand}" />
                    <Button Margin="8,0,0,0"
                            x:Name="SaveButton"
                            Style="{StaticResource SettingsPrimaryButtonStyle}"
                            Content="保存连接"
                            Command="{Binding SaveCommand}" />
                    <Button Margin="8,0,0,0"
                            x:Name="OfflineButton"
                            Style="{StaticResource SettingsSecondaryButtonStyle}"
                            Content="跳过，离线使用"
                            Click="OnOfflineClick" />
                </WrapPanel>
                <TextBlock Margin="0,12,0,0" Text="{Binding StatusText}" Style="{StaticResource SettingsStatusStyle}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource SettingsStatusStyle}"
                           Text="测试连接不会保存修改。" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
