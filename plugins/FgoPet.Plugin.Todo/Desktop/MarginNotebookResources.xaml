<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="Surface.App" Color="#FCFBF9"/>
 <SolidColorBrush x:Key="Surface.Content" Color="#FBFAF8"/>
 <SolidColorBrush x:Key="Surface.Hover" Color="#F2F0EB"/>
 <SolidColorBrush x:Key="Border.Control" Color="#CFC8BC"/>
 <SolidColorBrush x:Key="Border.Decorative" Color="#E1DCD3"/>
 <SolidColorBrush x:Key="Text.Primary" Color="#221F1B"/>
 <SolidColorBrush x:Key="ShellTextBrush" Color="#221F1B"/>
 <SolidColorBrush x:Key="ShellMutedTextBrush" Color="#6E6961"/>
 <SolidColorBrush x:Key="ShellPanelBackgroundBrush" Color="#FBFAF8"/>
 <SolidColorBrush x:Key="ShellBorderBrush" Color="#E1DCD3"/>
 <SolidColorBrush x:Key="ShellAccentBrush" Color="#B2718B"/>
 <SolidColorBrush x:Key="Focus.Ring" Color="#B2718B"/>
 <Style x:Key="MarginTodoButton" TargetType="Button">
  <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="Padding" Value="15,6"/><Setter Property="Foreground" Value="#45403A"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#CFC8BC"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Paper" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Paper" Property="BorderBrush" Value="#6E6961"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Paper" Property="BorderBrush" Value="#B2718B"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Paper" Property="Opacity" Value="0.55"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="MarginTodoPrimary" TargetType="Button" BasedOn="{StaticResource MarginTodoButton}">
  <Setter Property="Background" Value="#B2718B"/><Setter Property="BorderBrush" Value="#B2718B"/><Setter Property="Foreground" Value="White"/>
 </Style>
 <Style x:Key="MarginTodoInput" TargetType="TextBox">
  <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,5"/>
  <Setter Property="Background" Value="#FBFAF8"/><Setter Property="Foreground" Value="#221F1B"/>
  <Setter Property="BorderBrush" Value="#CFC8BC"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <Border x:Name="Paper" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Paper" Property="BorderBrush" Value="#B2718B"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Paper" Property="Opacity" Value="0.55"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <DataTemplate x:Key="ChatIcon"><Grid Width="12" Height="12"><Path Data="{Binding}" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Grid></DataTemplate>
 <Style x:Key="MarginTodoIcon" TargetType="Button" BasedOn="{StaticResource MarginTodoButton}">
  <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="7"/>
  <Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#9B958B"/>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F2F0EB"/><Setter Property="Foreground" Value="#221F1B"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#B2718B"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="MarginTodoNew" TargetType="Button" BasedOn="{StaticResource MarginTodoButton}">
  <Setter Property="Width" Value="200"/><Setter Property="Height" Value="28"/><Setter Property="FontSize" Value="12.5"/>
  <Setter Property="Foreground" Value="#9B958B"/><Setter Property="Background" Value="#FBFAF8"/><Setter Property="BorderBrush" Value="#E1DCD3"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,0"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#B2718B"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#CFC8BC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="MarginTodoTick" TargetType="CheckBox">
  <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/><Setter Property="Focusable" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Ellipse x:Name="Ring" Stroke="#CFC8BC" StrokeThickness="1"/><Path x:Name="Mark" Data="M3,7 L6,10 L12,4" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Fill" Value="#B2718B"/><Setter TargetName="Ring" Property="Stroke" Value="#B2718B"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#B2718B"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#B2718B"/><Setter TargetName="Ring" Property="StrokeThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="MarginTodoStepTick" TargetType="CheckBox" BasedOn="{StaticResource MarginTodoTick}">
  <Setter Property="Width" Value="16"/><Setter Property="Height" Value="20"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Ellipse Width="4" Height="4" Fill="#CFC8BC" HorizontalAlignment="Left"/><Ellipse x:Name="Focus" Stroke="#B2718B" StrokeThickness="1" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="MarginTodoExpander" TargetType="Expander">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Focus" BorderBrush="Transparent" BorderThickness="0,0,0,1"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="#B2718B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="Details" ContentSource="Content" Visibility="Collapsed" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
