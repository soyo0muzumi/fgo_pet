<UserControl Background="{DynamicResource Surface.App}" x:Class="FgoPet.App.Views.TodoWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FgoPet.Plugin.Todo.Desktop" FontFamily="Segoe UI" Foreground="#221F1B">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/FgoPet.UiSdk;component/Themes/SettingsControls.xaml"/><ResourceDictionary Source="/FgoPet.UiSdk;component/Ui/Shell/ChatControls.xaml"/><ResourceDictionary Source="MarginNotebookResources.xaml"/></ResourceDictionary.MergedDictionaries><Style TargetType="Expander" BasedOn="{StaticResource MarginTodoExpander}"><Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}"/></Style><Style TargetType="Button" BasedOn="{StaticResource MarginTodoButton}"/><Style TargetType="TextBox" BasedOn="{StaticResource MarginTodoInput}"/>
<BooleanToVisibilityConverter x:Key="Bool"/><local:TodoNotebookTextConverter x:Key="NotebookText"/>
<StreamGeometry x:Key="TodoEditGeometry">M3,13 L4.5,9.5 L11.5,2.5 L14,5 L7,12 Z M10,4 L12.5,6.5 M3,13 L6.5,12.5</StreamGeometry>
  <StreamGeometry x:Key="TodoMoreGeometry">M3,8 A1,1 0 1 0 3,8.1 M8,8 A1,1 0 1 0 8,8.1 M13,8 A1,1 0 1 0 13,8.1</StreamGeometry>
 <StreamGeometry x:Key="TodoUndoGeometry">M14,5 H6 A4,4 0 1 0 10,13 H14 M6,2 L3,5 L6,8</StreamGeometry>
<Style x:Key="TodoIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MarginTodoIcon}"><Setter Property="Focusable" Value="True"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/></Style>
<Style x:Key="TodoConfirmationButtonStyle" TargetType="Button" BasedOn="{StaticResource MarginTodoButton}"><Setter Property="ContentTemplate" Value="{x:Null}"/><Setter Property="Width" Value="Auto"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="10,4"/><Setter Property="Focusable" Value="True"/></Style>
<Style TargetType="ContextMenu"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource Border.Control}"/><Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/></Style>
<Style TargetType="MenuItem"><Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,6"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource Surface.Hover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></Style.Triggers></Style>
<Style x:Key="TodoRowFocusVisualStyle" TargetType="{x:Type Control}">
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Control}"><Border BorderBrush="{DynamicResource Focus.Ring}" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False"/></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="TodoRowItemContainerStyle" TargetType="{x:Type ContentPresenter}">
<Setter Property="Focusable" Value="True"/><Setter Property="FocusVisualStyle" Value="{StaticResource TodoRowFocusVisualStyle}"/>
</Style>
<DataTemplate x:Key="TodoRow">
<Border BorderThickness="0,0,0,1" Padding="0,15" Margin="0" CornerRadius="0">
<Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface.Content}"/><Setter Property="BorderBrush" Value="{DynamicResource Border.Decorative}"/><Style.Triggers><DataTrigger Binding="{Binding IsHighlighted}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<CheckBox Style="{StaticResource MarginTodoTick}" IsChecked="{Binding IsCompleted, Mode=OneWay}" IsEnabled="{Binding CanComplete}" Click="OnComplete" Tag="{Binding}" VerticalAlignment="Top" Margin="0,5,0,0"><AutomationProperties.Name><MultiBinding Converter="{StaticResource NotebookText}" ConverterParameter="task"><Binding Path="CompletionLabel"/><Binding/></MultiBinding></AutomationProperties.Name></CheckBox>
<Expander Grid.Column="1" Foreground="{DynamicResource ShellTextBrush}" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
<Expander.Header><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Item.Title}" TextWrapping="Wrap" FontSize="15.5" FontFamily="Georgia" LineHeight="24.8"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="#9B958B"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Grid.Column="1" Visibility="{Binding HasSteps, Converter={StaticResource Bool}}" Foreground="{DynamicResource ShellMutedTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,3,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource NotebookText}" ConverterParameter="progress"><Binding Path="StepProgressText"/><Binding/></MultiBinding></TextBlock.Text></TextBlock></Grid>
<ItemsControl ItemsSource="{Binding Steps}" Margin="0,8,0,0"><ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding HasSteps}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="4" Height="4" Fill="#CFC8BC" VerticalAlignment="Center" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding Item.Title}" FontSize="12.5" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Item.IsCompleted}" Value="True"><Setter Property="Foreground" Value="#9B958B"/><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock FontSize="11.5" Margin="0,5,0,0"><TextBlock.Text><MultiBinding Converter="{StaticResource NotebookText}" ConverterParameter="when"><Binding Path="Item"/><Binding/></MultiBinding></TextBlock.Text><TextBlock.Foreground><MultiBinding Converter="{StaticResource NotebookText}" ConverterParameter="whenColor"><Binding Path="Item"/><Binding/></MultiBinding></TextBlock.Foreground></TextBlock></StackPanel></Expander.Header>
 <StackPanel><StackPanel x:Name="RowDetails" Margin="0,8,0,0">

 <ItemsControl x:Name="StepItems" ItemsSource="{Binding Steps}" Margin="0,0,0,4">
<ItemsControl.ItemTemplate>
<DataTemplate>
<Grid Margin="0,3">
<Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<CheckBox Style="{StaticResource MarginTodoStepTick}" Grid.Column="0" IsChecked="{Binding Item.IsCompleted, Mode=OneWay}" IsEnabled="{Binding CanEditSteps}" Click="OnStepComplete" Tag="{Binding}" VerticalAlignment="Top" Margin="0,3,0,0" ><AutomationProperties.Name><MultiBinding Converter="{StaticResource NotebookText}" ConverterParameter="step"><Binding Path="CompletionLabel"/><Binding/></MultiBinding></AutomationProperties.Name></CheckBox>
<TextBlock x:Name="StepText" Grid.Column="1" Text="{Binding Item.Title}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Item.IsCompleted}" Value="True"><Setter Property="Foreground" Value="#9B958B"/><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBox x:Name="StepTitleInput" Grid.Column="1" Text="{Binding DraftTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="6,3" Visibility="Collapsed" Tag="{Binding}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.StepTitle}"/>
<StackPanel x:Name="StepDeleteConfirmation" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed">
<TextBlock Text="{x:Static local:TodoWorkspaceStrings.DeleteStepPrompt}"/>
<WrapPanel Margin="0,4,0,0"><Button Content="{x:Static local:TodoWorkspaceStrings.ConfirmDelete}" Click="OnConfirmDeleteStep" Tag="{Binding}" Style="{StaticResource TodoConfirmationButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.ConfirmDeleteStep}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.ConfirmDeleteStep}"/><Button Content="{x:Static local:TodoWorkspaceStrings.Cancel}" Click="OnCancelDeleteStep" Tag="{Binding}" Style="{StaticResource TodoConfirmationButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.CancelDeleteStep}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.CancelDeleteStep}" Margin="6,0,0,0"/></WrapPanel>
</StackPanel>
<WrapPanel x:Name="StepActions" Grid.Column="2" Margin="8,0,0,0">
 <Button x:Name="StepEditButton" Content="{StaticResource TodoEditGeometry}" ContentTemplate="{StaticResource ChatIcon}" Click="OnBeginStepEdit" Tag="{Binding}" IsEnabled="{Binding CanEditSteps}" Visibility="{Binding CanEditSteps, Converter={StaticResource Bool}}" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.EditStep}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.EditStep}"/>
<Button x:Name="StepSaveButton" Content="{StaticResource ChatCopied}" ContentTemplate="{StaticResource ChatIcon}" Click="OnSaveStepEdit" Tag="{Binding}" IsEnabled="{Binding CanSaveTitle}" Visibility="Collapsed" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.SaveStepEdit}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.SaveStepEdit}" Margin="6,0,0,0"/>
<Button x:Name="StepCancelButton" Content="{StaticResource ChatClose}" ContentTemplate="{StaticResource ChatIcon}" Click="OnCancelStepEdit" Tag="{Binding}" Visibility="Collapsed" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.CancelStepEdit}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.CancelStepEdit}" Margin="6,0,0,0"/>
 <Button x:Name="StepMoreButton" Content="{StaticResource TodoMoreGeometry}" ContentTemplate="{StaticResource ChatIcon}" Click="OnMore" Tag="{Binding}" IsEnabled="{Binding CanDelete}" Visibility="{Binding CanEditSteps, Converter={StaticResource Bool}}" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.MoreStepActions}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.MoreStepActions}">
<Button.ContextMenu><ContextMenu Opened="OnStepContextMenuOpened"><MenuItem Header="{x:Static local:TodoWorkspaceStrings.MoveStepUp}" Click="OnMoveStepUp" ToolTip="{x:Static local:TodoWorkspaceStrings.MoveStepUp}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.MoveStepUp}"/><MenuItem Header="{x:Static local:TodoWorkspaceStrings.MoveStepDown}" Click="OnMoveStepDown" ToolTip="{x:Static local:TodoWorkspaceStrings.MoveStepDown}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.MoveStepDown}"/><MenuItem Header="{x:Static local:TodoWorkspaceStrings.DeleteStep}" Click="OnBeginDeleteStep" ToolTip="{x:Static local:TodoWorkspaceStrings.DeleteStep}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.DeleteStep}"/></ContextMenu></Button.ContextMenu>
</Button>
</WrapPanel>
</Grid>
<DataTemplate.Triggers>
<DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter TargetName="StepText" Property="Visibility" Value="Collapsed"/><Setter TargetName="StepTitleInput" Property="Visibility" Value="Visible"/><Setter TargetName="StepEditButton" Property="Visibility" Value="Collapsed"/><Setter TargetName="StepSaveButton" Property="Visibility" Value="Visible"/><Setter TargetName="StepCancelButton" Property="Visibility" Value="Visible"/><Setter TargetName="StepMoreButton" Property="Visibility" Value="Collapsed"/></DataTrigger>
<DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True"><Setter TargetName="StepText" Property="Visibility" Value="Collapsed"/><Setter TargetName="StepTitleInput" Property="Visibility" Value="Collapsed"/><Setter TargetName="StepActions" Property="Visibility" Value="Collapsed"/><Setter TargetName="StepDeleteConfirmation" Property="Visibility" Value="Visible"/></DataTrigger>
</DataTemplate.Triggers>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
 <WrapPanel x:Name="ParentActions" Margin="0,8,0,4">
 <Button x:Name="AddStepButton" Content="{StaticResource ChatNew}" ContentTemplate="{StaticResource ChatIcon}" Click="OnBeginAddStep" Tag="{Binding}" IsEnabled="{Binding CanAddStep}" Visibility="{Binding CanEditSteps, Converter={StaticResource Bool}}" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.AddStep}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.AddStep}" Margin="0"/>
 <Button Content="{StaticResource ChatCopy}" ContentTemplate="{StaticResource ChatIcon}" Click="OnCopy" Tag="{Binding}" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.CopyTask}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.CopyTask}" Margin="0,0,2,0"/>
 <Button Content="{StaticResource TodoEditGeometry}" ContentTemplate="{StaticResource ChatIcon}" Click="OnEdit" Tag="{Binding}" IsEnabled="{Binding CanEditContent}" Visibility="{Binding CanEditContent, Converter={StaticResource Bool}}" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.EditTask}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.Edit}" Margin="0,0,2,0"/>
 <Button Content="{StaticResource TodoMoreGeometry}" ContentTemplate="{StaticResource ChatIcon}" Click="OnMore" Tag="{Binding}" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.MoreActions}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.MoreActions}">
 <Button.ContextMenu><ContextMenu DataContext="{Binding}" Opened="OnTodoContextMenuOpened"><MenuItem Header="{x:Static local:TodoWorkspaceStrings.Delete}" Tag="{Binding}" Click="OnDelete" IsEnabled="{Binding CanEdit}" ToolTip="{x:Static local:TodoWorkspaceStrings.DeleteTask}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.DeleteTask}"/></ContextMenu></Button.ContextMenu>
 </Button>
 </WrapPanel>

<StackPanel x:Name="AddStepEditor" Visibility="Collapsed" Margin="0,2,0,8">
<TextBox x:Name="NewStepTitleInput" Text="{Binding NewStepDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="6,3" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.NewStepTitle}"/>
<WrapPanel Margin="0,6,0,0"><Button x:Name="SaveNewStepButton" Content="{StaticResource ChatCopied}" ContentTemplate="{StaticResource ChatIcon}" Click="OnSaveNewStep" Tag="{Binding}" IsEnabled="{Binding CanSaveNewStep}" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.SaveStep}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.SaveStep}"/><Button x:Name="CancelNewStepButton" Content="{StaticResource ChatClose}" ContentTemplate="{StaticResource ChatIcon}" Click="OnCancelNewStep" Tag="{Binding}" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.CancelAddStep}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.CancelAddStep}" Margin="6,0,0,0"/></WrapPanel>
</StackPanel>
<StackPanel x:Name="CompletionConfirmation" Visibility="Collapsed" Margin="0,2,0,8">
<TextBlock TextWrapping="Wrap"><TextBlock.Text><MultiBinding Converter="{StaticResource NotebookText}" ConverterParameter="confirmation"><Binding Path="CompletionConfirmationText"/><Binding/></MultiBinding></TextBlock.Text></TextBlock>
<WrapPanel Margin="0,6,0,0"><Button Content="{x:Static local:TodoWorkspaceStrings.CompleteAnyway}" Click="OnConfirmCompletion" Tag="{Binding}" Style="{StaticResource TodoConfirmationButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.CompleteTaskAnyway}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.CompleteAnyway}"/><Button Content="{x:Static local:TodoWorkspaceStrings.Cancel}" Click="OnCancelCompletion" Tag="{Binding}" Style="{StaticResource TodoConfirmationButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.CancelCompleteTask}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.CancelCompletion}" Margin="6,0,0,0"/></WrapPanel>
</StackPanel>
 <TextBlock x:Name="DescriptionText" Text="{Binding Item.Description}" TextWrapping="Wrap" Visibility="{Binding HasDescription, Converter={StaticResource Bool}}"/>
 </StackPanel>
<StackPanel x:Name="RowEditor" Visibility="Collapsed" Margin="0,8,0,0">
<TextBlock Text="{x:Static local:TodoWorkspaceStrings.Title}" Margin="0,0,0,4"/>
<TextBox Tag="{Binding}" Text="{Binding DraftTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap" Padding="8" PreviewTextInput="OnTextInput" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.TaskTitle}"/>
<TextBlock Text="{x:Static local:TodoWorkspaceStrings.Notes}" Margin="0,10,0,4"/>
<TextBox Tag="{Binding}" Text="{Binding DraftDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Disabled" Padding="8" PreviewTextInput="OnTextInput" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.TaskNotes}"/>
<WrapPanel Margin="0,12,0,0">
<Button Content="{StaticResource ChatCopied}" ContentTemplate="{StaticResource ChatIcon}" Click="OnRowSave" Tag="{Binding}" IsEnabled="{Binding CanSaveDraft}" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.SaveEdit}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.SaveEdit}"/>
<Button Content="{StaticResource ChatClose}" ContentTemplate="{StaticResource ChatIcon}" Click="OnRowCancel" Tag="{Binding}" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.CancelEdit}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.CancelEdit}" Margin="8,0,0,0"/>
</WrapPanel></StackPanel></StackPanel></Expander></Grid></Border>
<DataTemplate.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter TargetName="RowDetails" Property="Visibility" Value="Collapsed"/><Setter TargetName="RowEditor" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsAddingStep}" Value="True"><Setter TargetName="AddStepButton" Property="Visibility" Value="Collapsed"/><Setter TargetName="AddStepEditor" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsConfirmingCompletion}" Value="True"><Setter TargetName="CompletionConfirmation" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
</DataTemplate>
</ResourceDictionary></UserControl.Resources>
  <Grid x:Name="NotebookBody" Margin="56,34,56,48" MaxWidth="760" HorizontalAlignment="Stretch" ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="TodoHeader" MinHeight="42" Margin="0,0,0,12" ClipToBounds="True">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="NotebookHeading" FontSize="15" FontFamily="Georgia" FontWeight="Normal" VerticalAlignment="Center"/>
    <TextBlock x:Name="NotebookSummary" Grid.Column="1" FontSize="12" Foreground="#9B958B" Margin="10,0,8,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=StatusText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource ShellMutedTextBrush}" VerticalAlignment="Center" Margin="14,0,8,0"/>
    <Button x:Name="UndoButton" Grid.Column="2" Content="{StaticResource TodoUndoGeometry}" ContentTemplate="{StaticResource ChatIcon}" Click="OnUndo" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.UndoCompletion}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.UndoCompletion}" Visibility="Collapsed"/>
    <Button x:Name="AddTaskButton" Grid.Column="3" Content="{x:Static local:TodoWorkspaceStrings.QuickAddPlaceholder}" Click="OnBeginAdd" Style="{StaticResource MarginTodoNew}" ToolTip="{x:Static local:TodoWorkspaceStrings.AddTask}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.AddTask}"/>
   <Border Grid.RowSpan="2" Grid.ColumnSpan="4" BorderBrush="#CFC8BC" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
   </Grid>
   <ScrollViewer x:Name="TodoScrollViewer" Grid.Row="1" Margin="0,4,0,0" Padding="0,0,0,8" ClipToBounds="True" CanContentScroll="False" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel><TextBlock FontFamily="Georgia" FontSize="14" x:Name="EmptyText" Text="{x:Static local:TodoWorkspaceStrings.Empty}" Foreground="{DynamicResource ShellMutedTextBrush}" TextWrapping="Wrap" Margin="0,18"/>
 <Border BorderBrush="#E1DCD3" BorderThickness="0,0,0,1" Margin="0,18,0,0" Padding="0,0,0,8"><TextBlock Text="{x:Static local:TodoWorkspaceStrings.StillRemembered}" FontSize="11" Foreground="#9B958B"/></Border><ItemsControl x:Name="ActiveItems" ItemTemplate="{StaticResource TodoRow}" ItemContainerStyle="{StaticResource TodoRowItemContainerStyle}"/>
 <Border x:Name="QuickAddEditor" Visibility="Collapsed" Background="{DynamicResource ShellPanelBackgroundBrush}" BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
 <StackPanel><TextBlock x:Name="EditorHeading" Text="{x:Static local:TodoWorkspaceStrings.QuickAdd}" FontWeight="SemiBold"/><TextBlock Text="{x:Static local:TodoWorkspaceStrings.Title}" Margin="0,10,0,4"/><TextBox x:Name="TitleInput" MaxLength="500" Padding="8" TextWrapping="Wrap" TextChanged="OnTitleTextChanged" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.TaskTitle}"/>
  <StackPanel x:Name="OptionalDescriptionPanel" Visibility="Collapsed"><TextBlock Text="{x:Static local:TodoWorkspaceStrings.Notes}" Margin="0,10,0,4"/><TextBox x:Name="DescriptionInput" MaxLength="4000" MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled" Padding="8" TextChanged="OnEditorTextChanged" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.TaskNotes}"/></StackPanel>
 <WrapPanel Margin="0,12,0,0"><Button x:Name="SaveButton" Content="{x:Static local:TodoWorkspaceStrings.Save}" Click="OnSave" IsEnabled="False" Style="{StaticResource MarginTodoPrimary}" Padding="16,6"/><Button x:Name="RevealDescriptionButton" Content="{x:Static local:TodoWorkspaceStrings.AddNotes}" Click="OnRevealDescription" Padding="12,6" Margin="8,0,0,0"/><Button Content="{StaticResource ChatClose}" ContentTemplate="{StaticResource ChatIcon}" Click="OnCancel" Style="{StaticResource TodoIconButtonStyle}" ToolTip="{x:Static local:TodoWorkspaceStrings.CancelAdd}" AutomationProperties.Name="{x:Static local:TodoWorkspaceStrings.Cancel}" Margin="8,0,0,0"/></WrapPanel></StackPanel>
 </Border>
 <Expander x:Name="CompletedSection" Margin="0,30,0,0" HorizontalContentAlignment="Stretch"><Expander.Header><Border BorderBrush="#E1DCD3" BorderThickness="0,0,0,1" Padding="0,0,0,8"><TextBlock Text="{x:Static local:TodoWorkspaceStrings.CompletedGroup}" FontSize="11" Foreground="#9B958B"/></Border></Expander.Header><ItemsControl x:Name="CompletedItems" ItemTemplate="{StaticResource TodoRow}" ItemContainerStyle="{StaticResource TodoRowItemContainerStyle}"/></Expander>
 </StackPanel></ScrollViewer>
</Grid></UserControl>
