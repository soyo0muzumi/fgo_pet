<UserControl x:Class="FgoPet.App.Settings.SpeechConnectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
<StackPanel>
        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <CheckBox Content="启用角色朗读" IsChecked="{Binding Enabled, Mode=TwoWay}" automation:AutomationProperties.Name="启用角色朗读" />
                <TextBlock Margin="0,5,0,0" Text="首版只朗读已完成的角色回复；不会安装、启动或下载任何本地模型。" Style="{StaticResource SettingsStatusStyle}" TextWrapping="Wrap" />
                <TextBlock Margin="0,14,0,5" Text="朗读服务" Style="{StaticResource SettingsCaptionStyle}" />
                <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                          ItemsSource="{Binding Providers}"
                          SelectedValuePath="Provider"
                          SelectedValue="{Binding Provider, Mode=TwoWay}"
                          automation:AutomationProperties.Name="朗读服务">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <Border>
            <StackPanel>
                <TextBlock Text="OpenAI 风格 HTTP" Style="{StaticResource SettingsCaptionStyle}" />
                <TextBlock Margin="0,0,0,4" Text="Base URL" Style="{StaticResource SettingsCaptionStyle}" />
                <TextBox Text="{Binding OpenAiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" automation:AutomationProperties.Name="朗读 Base URL" />
                <TextBlock Margin="0,10,0,4" Text="模型" Style="{StaticResource SettingsCaptionStyle}" />
                <TextBox Text="{Binding OpenAiModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" automation:AutomationProperties.Name="朗读模型" />
                <TextBlock Margin="0,10,0,4" Text="音色（手动填写）" Style="{StaticResource SettingsCaptionStyle}" />
                <TextBox Text="{Binding OpenAiVoice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" automation:AutomationProperties.Name="朗读音色" />
                <TextBlock Margin="0,10,0,4" Text="API Key" Style="{StaticResource SettingsCaptionStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource SettingsPasswordBoxStyle}" ToolTip="只保存到 Windows Credential Manager。" automation:AutomationProperties.Name="朗读 API Key" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="清除密钥" Command="{Binding ClearKeyCommand}" Style="{StaticResource SettingsSecondaryButtonStyle}" />
                </Grid>
                <TextBlock Margin="0,5,0,0" Text="{Binding KeyStateText}" Style="{StaticResource SettingsStatusStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsOpenAiCompatible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Border>
            <StackPanel>
                <TextBlock Text="GPT-SoVITS 本地服务" Style="{StaticResource SettingsCaptionStyle}" />
                <TextBlock Margin="0,0,0,4" Text="loopback 地址" Style="{StaticResource SettingsCaptionStyle}" />
                <TextBox Text="{Binding GptSoVitsBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" automation:AutomationProperties.Name="GPT-SoVITS 地址" />
                <TextBlock Margin="0,10,0,4" Text="参考音频位置" Style="{StaticResource SettingsCaptionStyle}" />
                <TextBox Text="{Binding GptSoVitsReferenceAudioPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" automation:AutomationProperties.Name="参考音频位置" />
                <TextBlock Margin="0,10,0,4" Text="参考文本" Style="{StaticResource SettingsCaptionStyle}" />
                <TextBox Text="{Binding GptSoVitsPromptText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" automation:AutomationProperties.Name="参考文本" />
                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Width="150" Margin="0,0,12,0"><TextBlock Text="文本语言" Style="{StaticResource SettingsCaptionStyle}" /><TextBox Text="{Binding GptSoVitsLanguage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" /></StackPanel>
                    <StackPanel Width="150"><TextBlock Text="参考语言" Style="{StaticResource SettingsCaptionStyle}" /><TextBox Text="{Binding GptSoVitsPromptLanguage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" /></StackPanel>
                </WrapPanel>
                <TextBlock Margin="0,10,0,0" Text="仅允许 loopback HTTP；本地服务配置不继承云端密钥。" Style="{StaticResource SettingsStatusStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding IsGptSoVits}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Border>
            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource SettingsCardStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsIndexTts}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel>
                <TextBlock Text="IndexTTS 本机服务" Style="{StaticResource SettingsCaptionStyle}"/>
                <TextBox Text="{Binding IndexTtsBaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" AutomationProperties.Name="IndexTTS 地址"/>
                <TextBlock Text="连接你已启动的 IndexTTS WebUI。不会安装模型或启动服务。" TextWrapping="Wrap" Style="{StaticResource SettingsStatusStyle}" Margin="0,6"/>
                <TextBlock Text="已保存音色" Style="{StaticResource SettingsCaptionStyle}"/>
                <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" DisplayMemberPath="Name" Style="{StaticResource SettingsComboBoxStyle}" AutomationProperties.Name="选择参考音色"/>
                <Button Content="删除所选音色副本" Click="OnDeleteVoiceClick" HorizontalAlignment="Left" Margin="0,8" Style="{StaticResource SettingsSecondaryButtonStyle}"/>
                <TextBlock Text="新音色名称" Style="{StaticResource SettingsCaptionStyle}" Margin="0,10,0,4"/>
                <TextBox Text="{Binding VoiceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Style="{StaticResource SettingsTextBoxStyle}" AutomationProperties.Name="新音色名称"/>
                <Button Content="导入 WAV 并保存音色" Click="OnImportVoiceClick" HorizontalAlignment="Left" Margin="0,8" Style="{StaticResource SettingsSecondaryButtonStyle}"/>
                <TextBlock Text="使用清晰、单人、无背景音乐的参考音频（WAV，最多 20 MB）。保存本机副本，克隆时发送给上方本机服务；不进行模型训练。切换音色后请保存朗读设置。" TextWrapping="Wrap" Style="{StaticResource SettingsStatusStyle}"/>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <TextBlock Text="播放" Style="{StaticResource SettingsCaptionStyle}" />
                <TextBlock Text="语速" Style="{StaticResource SettingsStatusStyle}" />
                <Slider Minimum="0.5" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Rate, Mode=TwoWay}" automation:AutomationProperties.Name="语速" />
                <TextBlock Text="{Binding Rate, StringFormat=语速 {0:F1}x}" Style="{StaticResource SettingsStatusStyle}" />
                <TextBlock Margin="0,8,0,0" Text="音量" Style="{StaticResource SettingsStatusStyle}" />
                <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Volume, Mode=TwoWay}" automation:AutomationProperties.Name="音量" />
                <TextBlock Text="{Binding Volume, StringFormat=音量 {0:P0}}" Style="{StaticResource SettingsStatusStyle}" />
                <CheckBox Margin="0,10,0,0" Content="允许自动朗读当前会话的新回复" IsChecked="{Binding AutoReadEnabled, Mode=TwoWay}" automation:AutomationProperties.Name="自动朗读" />
                <TextBlock Margin="0,4,0,0" Text="自动朗读默认关闭，并严格限制为当前会话、每条最多 300 字。" Style="{StaticResource SettingsStatusStyle}" TextWrapping="Wrap" />
                <CheckBox Margin="0,10,0,0" Content="免打扰时不自动朗读" IsChecked="{Binding DoNotDisturb, Mode=TwoWay}" automation:AutomationProperties.Name="免打扰" />
                <TextBlock Margin="0,4,0,0" Text="免打扰只阻止自动朗读；消息旁的手动朗读仍可使用。" Style="{StaticResource SettingsStatusStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock VerticalAlignment="Center" Text="自动朗读上限" Style="{StaticResource SettingsStatusStyle}" /><TextBox Width="70" Margin="8,0,0,0" Text="{Binding AutoReadLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" /></StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <WrapPanel>
                    <Button Content="试听" Command="{Binding PreviewCommand}" Style="{StaticResource SettingsSecondaryButtonStyle}" automation:AutomationProperties.Name="朗读试听" />
                    <Button Content="停止试听" Click="OnStopPreviewClick" Margin="8,0,0,0" Style="{StaticResource SettingsSecondaryButtonStyle}"/>
                    <Button Content="保存朗读设置" Command="{Binding SaveCommand}" Margin="8,0,0,0" Style="{StaticResource SettingsPrimaryButtonStyle}" />
                </WrapPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding StatusText}" Style="{StaticResource SettingsStatusStyle}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>