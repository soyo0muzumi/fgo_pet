<Project Sdk="Microsoft.NET.Sdk">

  <!-- 阶段 1 项目拆分：条目由 src/FgoPet.App 迁出。 -->
  <!-- Include 相对本 csproj；Link 逐字沿用（决定 WPF 资源 URI 与生成类命名空间）。 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FgoPet.App</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FgoPet.App.Tests" />
    <InternalsVisibleTo Include="FgoPet.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/FgoPet.UiSdk/FgoPet.UiSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Desktop\PackageDiagnosticViewModel.cs">
      <Link>modules\character\Desktop\PackageDiagnosticViewModel.cs</Link>
    </Compile>
    <Compile Include="Desktop\PersonalizationWebPage.cs">
      <Link>modules\character\Desktop\PersonalizationWebPage.cs</Link>
    </Compile>
    <Compile Include="Desktop\ThemeWebPage.cs">
      <Link>modules\character\Desktop\ThemeWebPage.cs</Link>
    </Compile>
    <Compile Include="Desktop\RolePackagesWebPage.cs">
      <Link>modules\character\Desktop\RolePackagesWebPage.cs</Link>
    </Compile>
    <Compile Include="Desktop\PersonalizationViewModel.cs">
      <Link>modules\character\Desktop\PersonalizationViewModel.cs</Link>
    </Compile>
    <Compile Include="Desktop\RecentServantSwitcherViewModel.cs">
      <Link>modules\character\Desktop\RecentServantSwitcherViewModel.cs</Link>
    </Compile>
    <Compile Include="Desktop\RolePackageDetailViewModel.cs">
      <Link>modules\character\Desktop\RolePackageDetailViewModel.cs</Link>
    </Compile>
    <Compile Include="Desktop\ServantAppearanceItemViewModel.cs">
      <Link>modules\character\Desktop\ServantAppearanceItemViewModel.cs</Link>
    </Compile>
    <Compile Include="Desktop\ServantCardViewModel.cs">
      <Link>modules\character\Desktop\ServantCardViewModel.cs</Link>
    </Compile>
    <Compile Include="Desktop\ServantLibraryViewModel.cs">
      <Link>modules\character\Desktop\ServantLibraryViewModel.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Desktop\ui\settings\personalization\personalization.js">
      <Link>Desktop\ui\settings\root\pages\personalization.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Desktop\ui\settings\personalization\personalization.css">
      <Link>Desktop\ui\settings\root\pages\personalization.css</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Desktop\ui\settings\theme\theme.js">
      <Link>Desktop\ui\settings\root\pages\theme.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Desktop\ui\settings\theme\theme.css">
      <Link>Desktop\ui\settings\root\pages\theme.css</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Desktop\ui\settings\role-packages\role-packages.js">
      <Link>Desktop\ui\settings\root\pages\role-packages.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Desktop\ui\settings\role-packages\role-packages.css">
      <Link>Desktop\ui\settings\root\pages\role-packages.css</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/FgoPet.Kernel/FgoPet.Kernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/FgoPet.Plugin.Content.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Application/CharacterSettingsRegistration.cs" />
  </ItemGroup>
</Project>
