  </ItemGroup>
  <ItemGroup>
    <!-- 前端资源由并行前端 agent 持有；此处仅按既定路径挂载到受控 root/pages。 -->
    <Content Include="Desktop\ui\settings\model-connection\model-connection.js">
      <Link>Desktop\ui\settings\root\pages\model-connection.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Desktop\ui\settings\model-connection\model-connection.css">
      <Link>Desktop\ui\settings\root\pages\model-connection.css</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Desktop\ui\chat\index.html" Condition="Exists('Desktop\ui\chat\index.html')">
      <Link>Desktop\ui\chat\index.html</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Desktop\ui\chat\chat.js" Condition="Exists('Desktop\ui\chat\chat.js')">
      <Link>Desktop\ui\chat\chat.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Desktop\ui\chat\chat.css" Condition="Exists('Desktop\ui\chat\chat.css')">
      <Link>Desktop\ui\chat\chat.css</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
