<UserControl x:Class="FgoPet.Plugin.Focus.Desktop.FocusCompactView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:FgoPet.Plugin.Focus.Desktop"
 xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
 FontFamily="Segoe UI" FontSize="13" Foreground="#221F1B" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
 MouseEnter="OnPeekEnter" MouseLeave="OnPeekLeave" GotKeyboardFocus="OnPeekFocus" LostKeyboardFocus="OnPeekFocus">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="9,6"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="#CFC8BC"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Foreground" Value="#45403A"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Paper" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Paper" Property="Background" Value="#F2F0EB"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="primary"/></MultiTrigger.Conditions><Setter TargetName="Paper" Property="Background" Value="#BE7995"/></MultiTrigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="ribbon"/></MultiTrigger.Conditions><Setter TargetName="Paper" Property="Background" Value="Transparent"/></MultiTrigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Paper" Property="BorderThickness" Value="1"/><Setter TargetName="Paper" Property="BorderBrush" Value="#B2718B"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Paper" Property="Opacity" Value="0.55"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="5,3"/><Setter Property="Background" Value="#FCFBF9"/><Setter Property="BorderBrush" Value="#CFC8BC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/></Style>
 </UserControl.Resources>
 <Grid Width="196">
  <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Height" Value="130"/></DataTrigger></Style.Triggers></Style></Grid.Style>
  <Grid x:Name="FocusSetupCard" Visibility="Collapsed">
   <ScrollViewer x:Name="SetupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><Grid>
   <StackPanel x:Name="QuickDurations" Margin="4">
    <TextBlock Text="{x:Static local:FocusStrings.Title}" FontFamily="Noto Serif SC, Source Han Serif SC, STSong, Yu Mincho, Times New Roman" FontSize="18" Margin="9,2,0,10"/>
    <Button x:Name="Quick10Button" Content="{x:Static local:FocusStrings.Quick10}" Tag="10" Click="OnQuickStart" IsEnabled="{Binding CanStartQuickFocus}"/>
    <Button x:Name="Quick25Button" Content="{x:Static local:FocusStrings.Quick25}" Tag="25" Click="OnQuickStart" IsEnabled="{Binding CanStartQuickFocus}"/>
    <Button x:Name="Quick50Button" Content="{x:Static local:FocusStrings.Quick50}" Tag="50" Click="OnQuickStart" IsEnabled="{Binding CanStartQuickFocus}"/>
    <Button x:Name="SessionOptionsButton" Click="OnSessionOptions" Margin="0,5,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{x:Static local:FocusStrings.Options}"/><TextBlock Text=" ›" Foreground="#9B958B"/></StackPanel></Button>
    <TextBlock Text="{Binding QuickStartDisabledReason}" FontSize="11" Foreground="#6E6961" TextWrapping="Wrap" Margin="9,2,9,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding QuickStartDisabledReason}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </StackPanel>
   <StackPanel x:Name="SessionOptions" Visibility="Collapsed" Margin="8,4">
    <Button x:Name="SessionBackButton" Click="OnSessionBack" Padding="0,0,0,8">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="‹" FontSize="19" Margin="0,0,4,0" VerticalAlignment="Center">
       <TextBlock.RenderTransform><TranslateTransform Y="-0.65"/></TextBlock.RenderTransform>
      </TextBlock>
      <TextBlock Text="{x:Static local:FocusStrings.Back}" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <TextBlock Text="{x:Static local:FocusStrings.Session}" FontFamily="Noto Serif SC, Source Han Serif SC, STSong, Yu Mincho, Times New Roman" FontSize="18" Margin="0,0,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{x:Static local:FocusStrings.Duration}" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="DurationInput" Text="{Binding CustomFocusMinutesText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" ToolTip="{Binding CustomFocusError}"/><TextBlock Grid.Column="2" Text="{x:Static local:FocusStrings.MinuteUnit}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,5"/>
     <TextBlock Grid.Row="1" Text="{x:Static local:FocusStrings.Break}" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomBreakMinutesText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5" ToolTip="{Binding CustomBreakError}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Static local:FocusStrings.MinuteUnit}" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,5"/>
     <TextBlock Grid.Row="2" Text="{x:Static local:FocusStrings.Cycles}" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomCyclesText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding CustomCyclesError}"/>
    </Grid>
    <TextBlock Text="{Binding StartFocusDisabledReason}" FontSize="11" Foreground="#A85460" TextWrapping="Wrap" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding StartFocusDisabledReason}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Button x:Name="StartFocusButton" Content="{x:Static local:FocusStrings.Start}" Tag="primary" Background="#B2718B" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Padding="15,6" Margin="0,12,0,0" Click="OnStartFocusClick" IsEnabled="{Binding CanStartFocus}"/>
   </StackPanel>
   </Grid></ScrollViewer>
  </Grid>
  <Grid x:Name="CompactTimer" Visibility="Collapsed" VerticalAlignment="Bottom">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/></Grid.RowDefinitions>
   <StackPanel x:Name="FocusPeek" Visibility="Collapsed" Margin="0,0,0,5">
    <Border Background="#FBFAF8" BorderBrush="#E1DCD3" BorderThickness="1" CornerRadius="6" Padding="12,8">
     <StackPanel>
      <TextBlock Text="{Binding RemainingText}" FontFamily="Cascadia Mono, Consolas" FontSize="17"/>
      <TextBlock x:Name="CompactPhaseText" Text="{Binding FocusStateText}" Foreground="#6E6961" FontSize="11" Margin="0,2,0,6"/>
      <StackPanel Orientation="Horizontal">
       <Button x:Name="PauseResumeButton" Content="{Binding PauseResumeText}" ToolTip="{Binding PauseResumeText}" Click="OnPauseResumeClick" Padding="0,4,12,4"/>
       <Button x:Name="StopTimerButton" Content="{x:Static local:FocusStrings.Stop}" Click="OnStopTimerClick" Padding="6,4" Foreground="#A85460"/>
      </StackPanel>
     </StackPanel>
    </Border>
   </StackPanel>
   <Button x:Name="RibbonButton" Grid.Row="1" Padding="0" Tag="ribbon" Click="OnRibbonClick" automation:AutomationProperties.Name="{x:Static local:FocusStrings.Controls}" HorizontalContentAlignment="Center">
    <Grid Width="172" Height="3"><Border Background="#57534D" CornerRadius="3"/>
     <ProgressBar x:Name="FocusProgressArc" Value="{Binding RibbonRemainingPercent, Mode=OneWay}" Minimum="0" Maximum="100" BorderThickness="0" Background="Transparent" Foreground="#B2718B" Height="3">
      <ProgressBar.Style><Style TargetType="ProgressBar"><Style.Triggers><DataTrigger Binding="{Binding CanResume}" Value="True"><Setter Property="Opacity" Value="0.5"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
      <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid><Border x:Name="PART_Track" Background="Transparent"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/></Grid></ControlTemplate></ProgressBar.Template>
     </ProgressBar>
    </Grid>
   </Button>
  </Grid>
 </Grid>
</UserControl>
