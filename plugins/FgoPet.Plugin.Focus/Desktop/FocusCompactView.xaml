<UserControl x:Class="FgoPet.Plugin.Focus.Desktop.FocusCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FgoPet.UiSdk;component/Ui/Shell/ChatControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <StreamGeometry x:Key="PetPlayIcon">M5,3 L12,8 L5,13 Z</StreamGeometry>
            <StreamGeometry x:Key="PetPauseIcon">M5,3 V13 M11,3 V13</StreamGeometry>
            <StreamGeometry x:Key="PetStopIcon">M3.5,3.5 H12.5 V12.5 H3.5 Z</StreamGeometry>
            <Style x:Key="PetDialChevronButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource Border.Control}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Action.Primary}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Focus.Ring}" />
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PetDialStartButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource Action.OnPrimary}" />
                <Setter Property="Background" Value="{DynamicResource Action.Primary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Action.Primary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="26">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Action.Primary}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Focus.Ring}" />
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
                <Grid x:Name="FocusSetupCard" Width="196" Height="196" Visibility="Collapsed">
                    <Ellipse Fill="{DynamicResource Surface.Content}"
                             Stroke="{DynamicResource Action.Primary}"
                             StrokeThickness="3"
                             Opacity="0.85" />
                    <Ellipse Margin="8"
                             Stroke="{DynamicResource Border.Control}"
                             StrokeThickness="4"
                             Opacity="0.7" />
                    <Grid Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                            <TextBlock Text="循环"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Text.Primary}"
                                       FontSize="11" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="‹" Tag="CyclesDown" Click="OnFocusAdjustClick" Style="{StaticResource PetDialChevronButtonStyle}" />
                                <TextBlock Text="{Binding CustomCyclesText}"
                                           MinWidth="24"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <Button Content="›" Tag="CyclesUp" Click="OnFocusAdjustClick" Style="{StaticResource PetDialChevronButtonStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="专注"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="11" />
                                <Grid Width="62" Height="62" Margin="0,1,0,0">
                                    <Ellipse Fill="{DynamicResource Surface.Subtle}"
                                             Stroke="{DynamicResource Border.Control}"
                                             StrokeThickness="2" />
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Content="⌃" Tag="FocusUp" Click="OnFocusAdjustClick" Style="{StaticResource PetDialChevronButtonStyle}" />
                                        <TextBlock Text="{Binding CustomFocusMinutesText}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <Button Content="⌄" Tag="FocusDown" Click="OnFocusAdjustClick" Style="{StaticResource PetDialChevronButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="休息"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Text.Primary}"
                                           FontSize="11" />
                                <Grid Width="62" Height="62" Margin="0,1,0,0">
                                    <Ellipse Fill="{DynamicResource Surface.Subtle}"
                                             Stroke="{DynamicResource Border.Control}"
                                             StrokeThickness="2" />
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Content="⌃" Tag="BreakUp" Click="OnFocusAdjustClick" Style="{StaticResource PetDialChevronButtonStyle}" />
                                        <TextBlock Text="{Binding CustomBreakMinutesText}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource ShellTextBrush}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <Button Content="⌄" Tag="BreakDown" Click="OnFocusAdjustClick" Style="{StaticResource PetDialChevronButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="StartFocusButton"
                                Grid.Row="2"
                                Content="{StaticResource PetPlayIcon}"
                                ContentTemplate="{StaticResource PetSolidIconTemplate}"
                                Click="OnStartFocusClick"
                                ToolTip="开始专注"
                                automation:AutomationProperties.Name="开始专注"
                                Style="{StaticResource PetDialStartButtonStyle}" />
                    </Grid>
                </Grid>
                <Grid x:Name="CompactTimer" Width="196" Height="196" Visibility="Collapsed">
                    <Ellipse Fill="{DynamicResource Surface.Content}"
                             Stroke="{DynamicResource Border.Control}"
                             StrokeThickness="1" />
                    <Ellipse Margin="5"
                             Stroke="{DynamicResource Border.Control}"
                             StrokeThickness="5"
                             Opacity="0.55" />
                    <Path x:Name="FocusProgressArc"
                          Width="186" Height="186"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stroke="{DynamicResource Action.Primary}"
                          StrokeThickness="5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent" />
                    <Grid Margin="34,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="CompactPhaseText"
                                       Text="{Binding FocusDisplay.Phase}"
                                       Foreground="{DynamicResource Action.Primary}"
                                       FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="CompactCycleText"
                                       Text="{Binding FocusDisplay.Cycle}"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding FocusDisplay.Remaining}"
                                   Foreground="{DynamicResource Text.Primary}"
                                   FontFamily="Consolas"
                                   FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button x:Name="PauseResumeButton"
                                    Content="{StaticResource PetPauseIcon}"
                                    ContentTemplate="{StaticResource PetIconTemplate}"
                                    ToolTip="暂停专注"
                                    automation:AutomationProperties.Name="暂停专注"
                                    Click="OnPauseResumeClick"
                                    Style="{StaticResource PetEntryButtonStyle}" />
                            <Button x:Name="StopTimerButton"
                                    Content="{StaticResource PetStopIcon}"
                                    ContentTemplate="{StaticResource PetIconTemplate}"
                                    ToolTip="结束专注"
                                    automation:AutomationProperties.Name="结束专注"
                                    Click="OnStopTimerClick"
                                    Style="{StaticResource PetEntryButtonStyle}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
    </Grid>
</UserControl>
